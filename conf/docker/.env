PROJECT_ENV="local"

# Uncomment VOLUME_SUFFIX for selinux enabled distros
# VOLUME_SUFFIX=ro,Z

# ActiveMQ variables
KPI_ACTIVEMQ_IMAGE=webcenter/activemq:5.14.3
KPI_ACTIVEMQ_ADMIN_LOGIN=admin
KPI_ACTIVEMQ_ADMIN_PASSWORD=password
KPI_ACTIVEMQ_HOST="kpi-${PROJECT_ENV}-activemq"
KPI_ACTIVEMQ_CONSOLE=8161
KPI_ACTIVEMQ_API=61616

# Kafka variables
KPI_KAFKA_IMAGE=bitnamilegacy/kafka:latest
KPI_KAFKA_CLUSTER_ID="kpi-${PROJECT_ENV}"
KPI_KAFKA_EXTERNAL_HOST=kafka.kpi.com
KPI_KAFKA_HOST_1="kpi-${PROJECT_ENV}-kafka-1"
KPI_KAFKA_PORT_1=9092
KPI_KAFKA_HOST_2="kpi-${PROJECT_ENV}-kafka-2"
KPI_KAFKA_PORT_2=9094
KPI_KAFKA_HOST_3="kpi-${PROJECT_ENV}-kafka-3"
KPI_KAFKA_PORT_3=9096

# Minio variables
KPI_MINIO_IMAGE=minio/minio:RELEASE.2025-01-20T14-49-07Z
KPI_MINIO_HOST="kpi-${PROJECT_ENV}-minio"
KPI_MINIO_CONSOLE=9000
KPI_MINIO_API=9001
KPI_MINIO_DOMAIN=storage.kpi.uz
KPI_MINIO_REDIRECT_URL=https://storage.kpi.uz/minio/ui
KPI_MINIO_ROOT_USER=aknbdev
KPI_MINIO_ROOT_PASSWORD=rootan321

# MongoDB variables
KPI_MONGODB_HOST="kpi-${PROJECT_ENV}-mongodb"
KPI_MONGODB_PORT=27017
KPI_MONGODB_MAX_MEMORY=8192m

# Load PGBouncer variables
KPI_PGBOUNCER_IMAGE="edoburu/pgbouncer:v1.24.0-p0"
KPI_PGBOUNCER_HOST="kpi-${PROJECT_ENV}-pgbouncer"
KPI_PGBOUNCER_PORT=6432

# RabbitMQ variables
KPI_RABBITMQ_HOST="kpi-${PROJECT_ENV}-rabbitmq"
KPI_RABBITMQ_CONSOLE=15672
KPI_RABBITMQ_API=5672

# Redis variables
KPI_REDIS_IMAGE=redis:7.2
KPI_REDIS_HOST="kpi-${PROJECT_ENV}-redis"
KPI_REDIS_PORT=6379
# Uncomment this and command iside redis/compose.yml file if you want to set pass
#KPI_REDIS_PASS=kpiPa$$$4redis
KPI_REDIS_MAX_MEMORY=256mb
KPI_REDIS_MAX_MEMORY_POLICY=allkeys-lru

# Solr variables
KPI_SOLR_IMAGE=solr:8.11.2
KPI_SOLR_HOST="kpi-${PROJECT_ENV}-solr"
KPI_SOLR_PORT=8983

