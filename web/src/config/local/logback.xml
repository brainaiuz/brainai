        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <file>${LOG_PATH}/${APP_NAME}-error.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${FILE_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${APP_NAME}-error.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
    </appender>-->

    <!-- ==================== SENTRY (local da odatda o'chiq) ==================== -->
<!--
    <appender name="Sentry" class="io.sentry.logback.SentryAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <options>
            <dsn>${sentry.dsn:-}</dsn>
        </options>
        <minimumEventLevel>ERROR</minimumEventLevel>
    </appender>
-->

    <!-- ==================== HIBERNATE ==================== -->
    <logger name="org.hibernate" level="warn"/>
    <logger name="org.hibernate.tool" level="error"/>

    <!-- SQL logi o'chirildi (warn ga o'tkazildi) -->
    <logger name="org.hibernate.SQL" level="warn"/>

    <!-- SQL parametr loglari o'chirildi -->
    <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="warn"/>

    <!-- Connection muammolarini ko'rish uchun -->
    <logger name="org.hibernate.engine.jdbc.spi.SqlExceptionHelper" level="error"/>
    <logger name="org.hibernate.resource.transaction" level="warn"/>

    <!-- ==================== THIRD PARTY ==================== -->
    <logger name="net" level="error"/>
    <logger name="javax" level="error"/>
    <logger name="org.apache.kafka" level="error"/>
    <logger name="org.aspectj" level="warn"/>
    <logger name="org.springframework.jms.listener" level="info" additivity="false">
        <appender-ref ref="STDOUT"/>
    </logger>

    <!-- FIX: info → warn (juda ko'p log chiqaradi) -->
    <logger name="org.springframework" level="warn"/>
    <logger name="org.springframework.web" level="warn"/>
    <logger name="org.springframework.transaction" level="warn"/>

    <!-- HikariCP -->
    <logger name="com.zaxxer.hikari" level="info"/>
    <logger name="com.zaxxer.hikari.pool" level="warn"/>

    <!-- ==================== APPLICATION ==================== -->
    <logger name="com.edatasite" level="debug"/>
    <logger name="com.finnetlimited" level="info"/>
    <logger name="com.workforcetrack" level="info"/>

    <!-- Transaction managers -->
    <logger name="com.edatasite.workforce.gwt.core.server.app.WfmJpaTransactionManager" level="warn"/>
    <logger name="com.edatasite.workforce.gwt.core.server.app.WfmJpaTemplate" level="warn"/>

    <!-- FIX: noto'g'ri package tuzatildi -->
    <logger name="com.edatasite.workforce.gwt.messagecenter" level="debug"/>
    <logger name="com.edatasite.workforce.gwt.core.server.rabbitmq" level="debug"/>

    <logger name="com.edatasite.workforce.rest.aspects" level="debug"/>

    <!-- ==================== ROOT ==================== -->
    <root level="info">
        <appender-ref ref="STDOUT"/>
       <!-- <appender-ref ref="FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="Sentry"/>-->
    </root>

</configuration>