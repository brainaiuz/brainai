<?xml version="1.0" encoding="UTF-8"?>
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:m="urn:import:gwt.material.design.client.ui">
    <g:HTMLPanel ui:field="htmlPanel">

        <div class="trmnlAtt-stack">

            <div class="trmnlAtt-card">
                <div class="trmnlAtt-card__head">
                    <span class="trmnlAtt-card__title" ui:field="inLabel"></span>
                    <span class="badge" ui:field="inActualLabel"></span>
                </div>


                <div class="trmnlAtt-card__grid">
                    <div class="trmnlAtt-col">
                        <label class="trmnlAtt-label" ui:field="inFaceIdLabel" style="display:block;min-height:2.4em;line-height:1.2;overflow:hidden"></label>
                        <div ui:field="inImgDiv" class="wg_photo-upload wg_photo-upload--uploaded genderIs--male trmnlAtt-photo-box">
                            <div class="wg_photo-upload__content">
                                <div class="profile-card-img__wrapper profile-card-img__wrapper--square">
                                    <div class="user-profile-img profile-card-img">
                                        <!--                                                        <img class="responsive-img" src="https://i.pravatar.cc/300?u=12" alt="Face"/>-->
                                        <img class="responsive-img" ui:field="inImg"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="trmnlAtt-meta" ui:field="inTimeLabel"> </div>
                    </div>

                    <div class="trmnlAtt-col">
                        <label class="trmnlAtt-label" ui:field="inLocationLabel" style="display:block;min-height:2.4em;line-height:1.2;overflow:hidden"></label>
                        <div class="trmnlAtt-map">
                            <iframe ui:field="inMapFrame" class="trmnlAtt-map__frame" style="width:100%;height:100%;border:0" frameborder="0"></iframe>
                            <img ui:field="inNoLocationImg" src="/mainStyles/images/no-location.png" alt="No location" style="width:100%;height:100%;object-fit:contain;padding:16px;box-sizing:border-box;background:#f4f6f8"/>
                        </div>
                        <div class="trmnlAtt-meta">
                            <a ui:field="inMapLink" target="_blank"></a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="trmnlAtt-card">
                <div class="trmnlAtt-card__head">
                    <span class="trmnlAtt-card__title" ui:field="outLabel"></span>
                    <span class="badge" ui:field="outActualLabel"></span>
                </div>

                <div class="trmnlAtt-card__grid">
                    <div class="trmnlAtt-col">
                        <label class="trmnlAtt-label" ui:field="outFaceIdLabel" style="display:block;min-height:2.4em;line-height:1.2;overflow:hidden"></label>
                        <div  ui:field="outImgDiv" class="wg_photo-upload wg_photo-upload--uploaded genderIs--male trmnlAtt-photo-box">
                            <div class="wg_photo-upload__content">
                                <div class="profile-card-img__wrapper profile-card-img__wrapper--square">
                                    <div class="user-profile-img profile-card-img">
                                        <img ui:field="outImg" alt="Map"/>

                                        <!--                                                        <img class="responsive-img" src="https://i.pravatar.cc/300?u=12" alt="Face"/>-->
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="trmnlAtt-meta" ui:field="outTimeLabel">Vaqt: </div>
                    </div>

                    <div class="trmnlAtt-col">
                        <label class="trmnlAtt-label" ui:field="outLocationLabel" style="display:block;min-height:2.4em;line-height:1.2;overflow:hidden"></label>
                        <div class="trmnlAtt-map">
                            <iframe ui:field="outMapFrame" class="trmnlAtt-map__frame" style="width:100%;height:100%;border:0" frameborder="0"></iframe>
                            <img ui:field="outNoLocationImg" src="/mainStyles/images/no-location.png" alt="No location" style="width:100%;height:100%;object-fit:contain;padding:16px;box-sizing:border-box;background:#f4f6f8"/>
                        </div>
                        <div class="trmnlAtt-meta">
                            <a ui:field="outMapLink" target="_blank"></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </g:HTMLPanel>
</ui:UiBinder>