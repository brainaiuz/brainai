<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:m="urn:import:gwt.material.design.client.ui"
             xmlns:mhtml="urn:import:gwt.material.design.client.ui.html"
             xmlns:kpi="urn:import:com.edatasite.workforce.gwt.core.client.ui"
             xmlns:components="urn:import:com.edatasite.workforce.gwt.core.client.ui.components">
    <g:HTMLPanel ui:field="panel">

        <m:MaterialCollapsible styleName="collapsible--arrows">
            <m:MaterialCollapsibleItem>
                <m:MaterialCollapsibleHeader>
                    <mhtml:Span ui:field="accountTitle"/>
                </m:MaterialCollapsibleHeader>
                <m:MaterialCollapsibleBody>
                    <g:HTMLPanel styleName="form-group">
                        <mhtml:Label ui:field="nameLabel" styleName="form-group__label"/>
                        <g:TextBox ui:field="name"/>
                    </g:HTMLPanel>

                    <g:HTMLPanel styleName="form-group">
                        <mhtml:Label ui:field="ownerLabel" styleName="form-group__label"/>
                        <g:HTMLPanel ui:field="ownerDiv"/>
                    </g:HTMLPanel>
                    <g:HTMLPanel styleName="form-group">
                        <mhtml:Label ui:field="emailLabel" styleName="form-group__label"/>
                        <g:TextBox ui:field="email"/>
                    </g:HTMLPanel>
                    <g:HTMLPanel styleName="form-group">
                        <mhtml:Label ui:field="phoneLabel" styleName="form-group__label"/>
                        <g:HTMLPanel ui:field="phoneDiv"/>
                    </g:HTMLPanel>
                    <g:HTMLPanel styleName="form-group">
                        <mhtml:Label ui:field="industryLabel" styleName="form-group__label"/>
                        <kpi:DataListBox ui:field="industry"/>
                    </g:HTMLPanel>
                </m:MaterialCollapsibleBody>
            </m:MaterialCollapsibleItem>
        </m:MaterialCollapsible>

        <m:MaterialCollapsible styleName="collapsible--arrows">
            <m:MaterialCollapsibleItem>
                <m:MaterialCollapsibleHeader>
                    <mhtml:Span ui:field="financialTitle"/>
                </m:MaterialCollapsibleHeader>
                <m:MaterialCollapsibleBody>
                    <g:HTMLPanel styleName="form-group" ui:field="bankAccountDiv">
                        <mhtml:Label ui:field="bankAccountLabel" styleName="form-group__label"/>
                        <kpi:DataListBox ui:field="bankAccount"/>
                    </g:HTMLPanel>

                    <g:HTMLPanel styleName="form-group">
                        <mhtml:Label ui:field="currencyLabel" styleName="form-group__label"/>
                        <kpi:DataListBox ui:field="currency"/>
                    </g:HTMLPanel>

                    <g:HTMLPanel styleName="form-group">
                        <mhtml:Label ui:field="accountReceivableLabel" styleName="form-group__label"/>
                        <g:HTMLPanel ui:field="accountReceivableDiv"/>
                    </g:HTMLPanel>

                    <g:HTMLPanel styleName="form-group">
                        <mhtml:Label styleName="form-group__label"/>
                        <components:KpiCheckBox ui:field="createGlAccountCheckBox"/>
                    </g:HTMLPanel>

                    <g:HTMLPanel styleName="form-group">
                        <mhtml:Label ui:field="balanceDateLabel" styleName="form-group__label"/>
                        <kpi:DatePicker ui:field="balanceDate"/>
                    </g:HTMLPanel>

                    <g:HTMLPanel styleName="form-group">
                        <mhtml:Label ui:field="balanceAmountLabel" styleName="form-group__label"/>
                        <g:TextBox ui:field="balanceAmount"/>
                    </g:HTMLPanel>

                </m:MaterialCollapsibleBody>
            </m:MaterialCollapsibleItem>
        </m:MaterialCollapsible>

    </g:HTMLPanel>
</ui:UiBinder>