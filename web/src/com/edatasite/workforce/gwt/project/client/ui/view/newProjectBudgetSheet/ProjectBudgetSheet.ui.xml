<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
             xmlns:g='urn:import:com.google.gwt.user.client.ui'
             xmlns:groupBox="urn:import:com.edatasite.workforce.gwt.core.client.ui.components.groupBox">

    <g:HTMLPanel styleName="pageContent_reporting" ui:field="exportPanel">

        <div class="operPanel operPanel--header">
            <g:HTMLPanel ui:field="filterPanel"/>
        </div>

        <div id="mainContent" class="inputs_sm trial_balance_report_table">
            <div class="textPanel clearfix delimit_top">
                <table cellpadding="0" cellspacing="0"
                       class="table table-condensed table-bordered table_tree table_striped_cols table-hover table_report table_leftIndex table_report_sections">
                    <thead class="point_affix_top text-nowrap" ui:field="header">
                        <tr>
                            <th class="stickerCell text-left">
                                <div class="frame_affix_top" style="min-width: 80px;" ui:field="accountText"></div>
                            </th>
                            <th class="stickerCell text-right">
                                <div class="frame_affix_top" style="min-width: 80px;" ui:field="plannedAmountText">Planned Amount</div>
                            </th>
                            <th class="stickerCell text-right">
                                <div class="frame_affix_top" style="min-width: 80px;" ui:field="actualAmountText">Actual Amount</div>
                            </th>
                            <th class="stickerCell text-right">
                                <div class="frame_affix_top" style="min-width: 80px;" ui:field="varianceText">% Variance</div>
                            </th>
                            <th class="stickerCell text-right">
                                <div class="frame_affix_top" style="min-width: 80px;" ui:field="varianceCostText">Variance Cost</div>
                            </th>
                        </tr>
                    </thead>
                    <tbody ui:field="revenueGroup" class="category_set"/>
                    <tbody ui:field="expensesGroup" class="category_set"/>
                    <tbody ui:field="totalsLine"/>
                </table>
            </div>
        </div>
    </g:HTMLPanel>
</ui:UiBinder>
