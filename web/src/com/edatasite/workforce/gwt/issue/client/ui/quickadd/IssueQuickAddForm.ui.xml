<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:m="urn:import:gwt.material.design.client.ui"
             xmlns:w="urn:import:com.edatasite.workforce.gwt.core.client.ui"
             xmlns:mhtml="urn:import:gwt.material.design.client.ui.html"
             xmlns:kpi="urn:import:com.edatasite.workforce.gwt.core.client.ui">

    <g:HTMLPanel ui:field="panel">

        <m:MaterialCollapsible styleName="collapsible--arrows">
            <m:MaterialCollapsibleItem>
                <m:MaterialCollapsibleHeader>
                    <mhtml:Span ui:field="details"/>
                </m:MaterialCollapsibleHeader>
                <m:MaterialCollapsibleBody>
                    <g:HTMLPanel styleName="form-group">
                        <mhtml:Label ui:field="numberLabel" styleName="form-group__label"/>
                        <g:HTMLPanel ui:field="numberDiv"/>
                    </g:HTMLPanel>

                    <g:HTMLPanel styleName="form-group">
                        <mhtml:Label ui:field="projectLabel" styleName="form-group__label"/>
                        <g:HTMLPanel ui:field="projectDiv"/>
                    </g:HTMLPanel>
                    <g:HTMLPanel styleName="form-group">
                        <mhtml:Label ui:field="nameLabel" styleName="form-group__label"/>
                        <g:TextBox debugId="issue_name" ui:field="name"/>
                    </g:HTMLPanel>

                    <g:HTMLPanel styleName="form-group">
                        <mhtml:Label ui:field="descriptionLabel" styleName="form-group__label"/>
                        <w:TextArea2 width="100%" ui:field="description"/>
                    </g:HTMLPanel>

                    <g:HTMLPanel styleName="form-group form-group--inline">
                        <g:HTMLPanel styleName="form-group__item">
                            <mhtml:Label ui:field="startDateLabel" styleName="form-group__label"/>
                            <kpi:DatePicker ui:field="startDate"/>
                        </g:HTMLPanel>
                        <g:HTMLPanel styleName="form-group__item">
                            <mhtml:Label ui:field="dueDateLabel" styleName="form-group__label"/>
                            <kpi:DatePicker ui:field="dueDate"/>
                        </g:HTMLPanel>
                    </g:HTMLPanel>
                </m:MaterialCollapsibleBody>
            </m:MaterialCollapsibleItem>
        </m:MaterialCollapsible>
        <m:MaterialCollapsible styleName="collapsible--arrows">
            <m:MaterialCollapsibleItem>
                <m:MaterialCollapsibleHeader>
                    <mhtml:Span ui:field="involvedEmployeesTitle"/>
                </m:MaterialCollapsibleHeader>
                <m:MaterialCollapsibleBody>
                    <g:HTMLPanel styleName="form-group">
                        <mhtml:Label ui:field="assigneeLabel" styleName="form-group__label"/>
                        <g:HTMLPanel ui:field="assignee"/>
                    </g:HTMLPanel>
                </m:MaterialCollapsibleBody>
            </m:MaterialCollapsibleItem>
        </m:MaterialCollapsible>
    </g:HTMLPanel>
</ui:UiBinder>