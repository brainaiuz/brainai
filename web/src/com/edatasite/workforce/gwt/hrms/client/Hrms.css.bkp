/* ----------------------------------- Expense Style Start ----------------------------------------------- */

.productstable #top {
    background-repeat: repeat-x;
    color: #FFFFFF;
    font-weight: bold;
    height: 25px;
}

.contentBar {
    position: relative;
    height: 100%;
}

.contentScroll {
    height: 100%;
}

.mainBar {
    min-height: 100%;
    padding: 0 9px 0 14px;
    vertical-align: top;
}

.mainBar .contentBox {
}

.mainBar>.group {
    margin-bottom: 18px;
}

.invoice-block {
    padding-bottom: 20px;
}

.invoice-block .label,
.invoice-type .label,
.progress-invoicing .label {
    font: bold 12px/24px Arial, sans-serif;
    color: #002b6d;
}

.invoice-project,
.invoice-date,
.invoice-customer {
    margin-right: 20px;
}

.invoice-project,
.invoice-date,
.invoice-due-date,
.invoice-customer {
    float: left;
}

.invoice-type {
    float: right;
}

.progress-invoicing {
    float: right;
    padding-top: 20px;
}

.progress-invoicing span input {
    margin-right: 5px;
}

.invoice-customer .gwt-SuggestBox {
    width: 170px !important;
    height: 17px;
    font-size: 12px;
}

.invoice-project .gwt-SuggestBox {
    width: 150px !important;
    height: 17px;
    font-size: 12px;
}

.invoice-due-date .datePicker,
.invoice-date .datePicker {
    width: 80px;
    height: 17px;
    font-size: 12px;
}

.invoice-num .number {
    height: 17px;
    width: 187px;
    font-size: 12px;
    font-weight: bold;
}

.invoice-block .titlelabel {
    font-size: 15px;
}

.invoice-type .invoicetypelist {
    height: 21px;
    width: 130px;
    font-size: 13px;
}

.invoice-num {
    float: right;
}

.invoice-num .label {
    float: left;
    line-height: 20px;
    margin-right: 10px;
}

.invoice-num .gwt-Label {
    margin-top: 4px;
    float: right;
}

.invoice-title {
    float: left;
    overflow: hidden;
    font: bold 16px/24px Arial, sans-serif;
    color: #002b6d;
}

.invoice-copyfrom {
    float: left;
    margin-left: 20px;
    margin-top: 3px;
}

.invoice-bill-to,
.invoice-ship-to {
    min-width: 250px;
    min-height: 114px;
    border: 1px solid #737373;
    overflow: hidden;
}

.addresshead {
    background-color: #eaeaea;
    padding: 5px;
    overflow: hidden;
    min-width: 250px;
}

.invoice-bill-to {
    float: left;
    position: relative;
}

.addresslabel,
.addresslist,
.mailAddressList,
.add-edit-links .addresslink {
    float: left;
    margin-right: 8px;
    line-height: 20px;
}

.add-edit-links {
    float: left;
}

.add-edit-links .addresslink {
}

.addressdata {
    padding: 5px;
}

.invoice-ship-to {
    float: right;
    position: relative;
}

.invoice-ship-via,
.invoice-price-level,
.invoice-amounts,
.invoice-reference,
.related-text {
    float: right;
    margin-left: 20px;
}

.invoice-ship-via input,
.invoice-price-level input,
.invoice-amounts select,
.invoice-reference input,
.related-text input {
    width: 120px;
}

.invoice-add-introduction {
    padding: 25px 5px 20px 0;
}

.invoice-payment-instructions .instructionlabel,
.invoice-add-introduction .introductionlabel {
    color: #002b6d;
    font: bold 13px/19px Arial, sans-serif;
    padding-left: 25px;
    background: url(accounting/images/mark-add-intro.png) 0 50% no-repeat;
    text-decoration: underline;
    margin-bottom: 15px;
}

.invoice-add-introduction .introduction {
    width: 100%;
    height: 70px;
}

.invoice-products {
    overflow: hidden;;
    margin-bottom: 30px;
}

.invoice-products a {
    font: bold 13px/19px Arial, sans-serif;
    color: #237e3d;
    text-decoration: underline;
}

.productstable {
    border: 0;
    margin-bottom: 5px;
    word-wrap: break-word;
}

.productstable > tbody > tr:first-child > td:first-child {
    border-left: none;
    width: 50px;
}

.productstable > tbody > tr:first-child > td {
    background-color: #1286c3;
    color: #ffffff;
    border-right: 1px solid #003382;
    border-left: 1px solid #3db9df;
    font: bold 11px/24px Arial, sans-serif;
}

.productstable > tbody > tr > td {
    padding: 3px;
}

.productstable .odd > td {
    background-color: #f3f3f3;
}

.invoice-paymentpanel {
    float: left;
}

.invoice-paymentexrate {
    margin-top: 10px;
}

.invoice-subtotal {
    float: right;
    position: relative;
    background-color: #f2f2f2;
    padding: 15px;
    margin-bottom: 10px;
}

.invoice-subtotal .corner {
    background-image: url(accounting/images/corners-gray.png);
    background-repeat: no-repeat;
    width: 10px;
    height: 10px;
    display: block;
    position: absolute;
    /*z-index: 10;*/
}

.corner.lt {
    background-position: 0 0;
    top: 0;
    left: 0;
}

.corner.rt {
    background-position: 100% 0;
    top: 0;
    right: 0;
}

.corner.lb {
    background-position: 0 100%;
    bottom: 0;
    left: 0;
}

.corner.rb {
    background-position: 100% 100%;
    bottom: 0;
    right: 0;
}

.totalstable > tbody > tr > td {
    padding: 5px;
}

.totalvalue {
    font: 14px/20px Arial, sans-serif;
    text-align: right;
    color: #ffffff;
    background-color: #1286c3;
    padding: 0 5px 0 10px;
    test: Hrms;
}

.totallabel {
    color: #002b6d;
    font: bold 14px/20px Arial, sans-serif;
    text-align: left;
    padding: 0 10px 0 0;
    background-color: #f2f2f2;
}

.invoice-payment-instructions {
    overflow: hidden;
}

.invoice-payment-instructions .termsinstruction {
    width: 95%;
}

.invoice-payment-instructions .termstxtarea {
    width: 95%;
    height: 110px;
}

.termsinstruction .gwt-TextArea {
    width: 100%;
    height: 110px;
}

.invoice-btn-expense button {
    width: 115px;
    margin-right: 15% !important;
}

.invoice-btns-row {
    text-align: right;
    margin-top: 20px;
    clear: both;
}

.invoice-btns-row div + div {
    margin-left: 10px;
}

.invoice-btns-row div {
    display: inline;
}

.invoice-btns-row button {
    background-color: transparent;
    background-image: url(accounting/images/bg_btns-invoice.png);
    background-repeat: no-repeat;
    font: bold 12px Arial, sans-serif;
    height: 29px;
    border: none;
    padding: 0;
}

.invoice-btn-default button {
    width: 128px;
    background-position: -103px 0;
}

.invoice-btn-save button {
    background-position: 0 0;
    width: 103px;
    padding-left: 35px;
}

.invoice-btn-save-approve button {
    width: 128px;
    background-position: -103px 0;
}

.invoice-btn-approve button {
    background-position: -231px 0;
    width: 170px;
    padding-left: 35px;
}

.invoice-btn-pdf button {
    width: 103px;
    padding-left: 20px;
    background-position: 100% 0;
}

/**** START invoiceTable
=================================================================****/
.bindContent .sidebar {
    min-width: 191px;
    border: 1px solid #ccc;
    background: #f0ffe2;
    vertical-align: top;
}

.sortBar {
    padding-bottom: 15px;
}

.sortBar>li {
    position: relative;
    display: inline-block;
    vertical-align: bottom;
}

.sortBar>li+li {
    margin-left: 18px;
}

.sortBar>li>label:first-child {
    margin-left: 5px;
    font: bold 12px Arial, sans-serif;
    color: #002b6d;
}

.sortBar>li>select,
.sortBar>li>input[type="text"] {
    display: block;
}

.sortBar .addTerm {
    position: absolute;
}

/* Start invoiceTable sidebar */
.inv-OptBar {
    padding: 10px 7px 0;
    min-width: 210px;
}

/* .inv-OptBar table {margin:25px 0 0 0;} */
.inv-OptBar table td {
    padding: 5px 3px;
}

.inv-OptBar .exRate input {
    width: 55px;
    height: 17px;
    font-size: 12px;
}

.inv-OptBar .exRate select {
    width: 60px;
    height: 21px;
    font-size: 13px;
    margin-left: 5px;
}

.inv-OptBar .bankDetails select {
    width: 120px;
    height: 21px;
    font-size: 13px;
}

.inv-OptBar .optBarTitle {
    font-size: 14px;
    line-height: 22px;
    background-color: #0077bf;
    font-weight: bold;
    color: #fff;
    padding-left: 12px;
    border-bottom: 1px solid #238bc4;
    border-top: 1px solid #097cc0;
}

.inv-OptBar .optBarBlock {
    overflow: hidden;
    margin-bottom: 30px;
}

.optBarBlock .colSortlist {
    margin: 10px 0 0;
    list-style: disc outside url(accounting/images/list-arrow.png);
    margin-left: 20px;
}

.optBarBlock .colSortlist li {
    position: relative;
    font-size: 14px;
    color: #004670;
    padding: 5px 20px 5px 0;
    border-bottom: 1px solid #a2c87e;
}

.optBarBlock .colSortlist li .btnRemove {
    display: block;
    width: 14px;
    height: 14px;
    position: absolute;
    right: 0;
    top: 50%;
    margin-top: -7px;
    background: url(accounting/images/marks-1.png) no-repeat -1px 100%;
}

.optBarBlock .uploadbutton {
    background: url(accounting/images/bg_btn-upload.png) 0 0 no-repeat;
    border: none;
    margin-left: 30px;
    margin-top: 20px;
    padding-left: 30px;
    padding-right: 10px;
    font: bold 13px Arial, sans-serif;
    color: #ffffff;
    height: 28px;
}

.optBarBlock .btn-1 {
    margin-left: 20px;
}

.inv-OptBar .addnote {
    margin-left: 30px;
    margin-top: 20px;
    color: #237e3d;
    font-size: 13px;
    font-weight: bold;
    text-decoration: none;
    border-bottom: 1px solid #237e3d;
}

.inv-OptBar .currencyList,
.inv-OptBar .exchangeRate,
.inv-OptBar .baseExchangeRate {
    width: 55px;
    float: left;
    margin-right: 5px;
}

.inv-OptBar .baseExchangeRate {
    line-height: 25px;
}

.inv-OptBar .customTitle {
    width: 60px;
    display: block;
}

.inv-OptBar .customwidget {
    width: 100px
}

.notespanel {
    padding-top: 5px;
    margin: 0 !important;
    width: 100%;
}

.notespanel table {
    margin: 0 !important;
    width: 100%;
}

.notespanel table tr td:first-child {
    background: url(accounting/images/list-arrow.png) 0 10px no-repeat;
}

.notespanel table td {
    padding: 0;
    border-bottom: 1px solid #a2c87e;
    vertical-align: middle !important;
}

.notespanel .gwt-HTML {
    position: relative;
    font-size: 14px;
    color: #004670;
    padding: 5px 20px 5px 0;
    margin-left: 12px;
    width: 163px;
    word-wrap: break-word;
}

/***************************** END inv-OptBar *******************************/

/*********************************Expense Styles Start*******************************/

.lineItem {
    float: left;
}

.lineItem+.lineItem {
    margin-left: 20px;
    margin-bottom: 10px;
}

.lineItem.voidTopLabel {
    margin-top: 24px;
}

.lineItem .datePicker,
.lineItem .number,
.lineItem .reference,
.lineItem .exchangeRate,
.lineItem .select,
.lineItem .projectlist .gwt-SuggestBox {
    font-size: 12px
}

.lineItem .number {
    height: 20px;
    width: 187px;
}

.lineItem .reference {
    height: 20px;
    width: 400px;
}

.lineItem .projectlist .gwt-SuggestBox {
    height: 18px;
}

.lineItem select {
    height: 25px;
}

.lineItem .exchangeRate {
    height: 20px;
}

.customwidget .gwt-RadioButton, .customwidget .gwt-CheckBox {
    display: block;
}

/* ----------------------------------- Expense Style End ----------------------------------------------- */

/* ----------------------------------- OPTIMO PERIOD TABLES ----------------------------------------------- */
.optimoPeriods>tbody>tr>td {width:40%}
.optimoPeriods>tbody>tr>td+td {width:40%}
.optimoPeriods>tbody>tr>td+td+td {width:25%}
.optimoPeriods>tbody>tr>td+td+td+td {width:31px}

/*OrgChart style begin*/
div.orgChart {
    /*border                : 1px solid #cccccc;
    background-color      : #ffffe8;*/
    margin: 10px;
    padding: 20px;
}

div.orgChart table {
    width: 100%;
}

div.orgChart tr.tlines td.tline {
    width: 1px;
    height: 20px;
}

div.orgChart tr.tlines td.ttop {
    border-top: 2px solid #4f88bb;
}

div.orgChart tr.tlines td.tleft {
    border-right: 1px solid #4f88bb;
}

div.orgChart tr.tlines td.tright {
    border-left: 1px solid #4f88bb;
}

div.orgChart td {
    text-align: center;
    vertical-align: top;
    padding: 0 2px;
}

div.orgChart div.node {
    cursor: default;
    border: 2px solid #4f88bb;
    display: inline-block;
    padding: 4px;
    min-width: 150px;
    min-height: 48px;
    text-align: left;
    background-color: #ffffcf;
    line-height: 1.2em;
    border-radius: 8px;
    box-shadow: 4px 4px 6px #888888;
    -moz-border-radius: 8px;
    -moz-box-shadow: 4px 4px 6px #888888;
    -webkit-border-radius: 8px;
    -webkit-box-shadow: 4px 4px 6px #888888;
}

div.orgChart div.hasChildren {
    background-color: #FFFFFF;
}

div.orgChart.interactive div.hasChildren {
    cursor: pointer;
}

div.orgChart div.node.hover {
    background-color: white;
}

div.orgChart div.adjunct.node {
    position: absolute;
    margin-top: 8px;
    margin-left: -110px;
    width: 80px;
    height: 40px;
    background-color: white;
}

div.orgChart div.adjunct-link {
    display: inline-block;
    position: absolute;
    margin-left: -20px;
    margin-top: 25px;
    width: 20px;
    border: 2px dashed #4f88bb;
}

div.orgChart .overhide {
    overflow: hidden;
}

div.orgChart em {
    font-size: 10px;
    font-weight: normal;
    color: rgb(128, 128, 128);
}

div.orgChart h2 {
    margin: 0;
    font-size: 11px;
    font-weight: bold;
    color: rgb(64, 64, 64);
}

div.orgChart .circular-portrait {
    position: relative;
    float: left;
    width: 40px;
    height: 40px;
    overflow: hidden;
    margin-right: 5px;
    border-radius: 50%;
    -webkit-border-radius: 50%;
    -moz-border-radius: 50%;
}

div.orgChart .circular-portrait img {
    width: 100%;
    height: auto;
}

div.orgChart .ttree, .ttree ul {
    list-style-type: none;
    margin: 0;
    padding: 0;
    position: relative;
    overflow: hidden;
}

div.orgChart .ttree li {
    margin: 0;
    padding: 0 10px;
    position: relative;
    left: 10px;
    font-size: 11px;
    font-weight: normal;
}

div.orgChart .ttree li::before, .ttree li::after {
    content: '';
    position: absolute;
    left: 0;
}

/* horizontal line on inner list items */
div.orgChart .ttree li::before {
    /*border-top: 1px solid #B5A8FD;*/
    top: 10px;
    width: 12px;
    height: 0;
}

/* vertical line on list items */
div.orgChart .ttree li:after {
    /*border-left: 1px solid #B5A8FD;*/
    height: 100%;
    width: 0;
    top: -10px;
}

/* lower line on list items from the first level because they don't have parents */
div.orgChart .ttree > li::after {
    top: 10px;
}

/* hide line from the last of the first level list items */
div.orgChart .ttree > li:last-child::after {
    display: none;
}

/*OrgChart style end*/

.ttree-dropbtn {
    color: white;
    padding: 0 4px;
    border: none;
    cursor: pointer;
    display: block;
    overflow: hidden;
    background-color: #fff;
    background-image: url('/mainStyles/down.png');
    background-repeat: no-repeat;
    background-position: 3px 5px;
}

.ttree-dropdown {
    position: relative;
    display: inline-block;
}

.ttree-dropdown-content {
    display: none;
    position: absolute;
    right: 0;
    background-color: #fff;
    min-width: 120px;
    font-size: 11px;
    border: 1px solid rgba(0, 0, 0, 0.2);
}

.ttree-dropdown-content a {
    color: black;
    padding: 8px 6px 8px 20px;
    text-decoration: none;
    display: block;
    white-space: nowrap;
    background-repeat: no-repeat !important;
    background-position: 3px 6px;
}

.ttree-dropdown-content a:hover {
    background-color: #f1f1f1
}

.ttree-dropdown:hover .ttree-dropdown-content {
    display: block;
}

.ttree-wrapword {
    white-space: -moz-pre-wrap !important; /* Mozilla, since 1999 */
    white-space: -webkit-pre-wrap; /*Chrome & Safari */
    white-space: -pre-wrap; /* Opera 4-6 */
    white-space: -o-pre-wrap; /* Opera 7 */
    white-space: pre-wrap; /* css-3 */
    word-wrap: break-word; /* Internet Explorer 5.5+ */
    word-break: break-all;
    white-space: normal;
}