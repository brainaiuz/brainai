<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
             xmlns:g='urn:import:com.google.gwt.user.client.ui'>

    <g:FlowPanel styleName="orgPositionCard">
        <g:Label ui:field="title" styleName="orgPosition-title"/>
        <g:Label ui:field="owner" styleName="orgPosition-owner"/>
        <g:HTML ui:field="description" styleName="orgPosition-desc"/>
        <g:HTML ui:field="metrics" styleName="orgPosition-metrics"/>
    </g:FlowPanel>
</ui:UiBinder>
