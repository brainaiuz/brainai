<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
             xmlns:g='urn:import:com.google.gwt.user.client.ui'
             xmlns:k='urn:import:com.edatasite.workforce.gwt.core.client.ui'
             xmlns:design="urn:import:gwt.material.design.client.ui">
    <ui:style>
        .topPanelDiv {
            padding: 7px;
            height: 25px;
        }

        .main {
            width: 100%;
            text-align: center;
            padding-top: 30px;
            font-family: Verdana, sans-serif;
            font-size: 15px;
            font-weight: bold;
            color: #2568ac;
        }

        .image {
            width: 100%;
            width: 400px;
            height: 300px;
        }

        .wrapper {
            width: 100%;
            heigh: 100%;
        }

        .contactUs {
            text-decoration: underline;
            color: #00b6f1;
            font-size: 13pt;
            font-weight: bold;
        }


    </ui:style>

    <g:HTMLPanel width="100%" height="100%" ui:field="panel">
        <div class="orgChart__container">
            <div class="orgChart__header fixed-content">
                <div class="orgChart__switchView ">
                    <design:MaterialButton ui:field="refresh"/>
                    <div class="orgChart__title txt-elem--base-dark btnReload"></div>
                </div>

                <g:HTMLPanel styleName="orgChart__switchView operPanel__settings" ui:field="switchDiv">

                </g:HTMLPanel>

                <g:HTMLPanel styleName="orgChart__switchView operPanel__settings" ui:field="exportBtn">

                </g:HTMLPanel>

                <div class="orgChart__switchView">
                    <div class="dropdown-select--arrow dropdown-kit--below">
                        <k:DataListBox ui:field="levelOptionList" width="175px"/>
                    </div>
                </div>
            </div>


            <div ui:field="content" class="orgChart orgChart--1"></div>
            <div ui:field="wrapper" class="{style.wrapper}" align="center">
                <div ui:field="imageDiv" class="{style.image}">
                    <!-- HERE GOES IMAGE -->
                </div>
                <div ui:field="main" class="{style.main}">
                    <div ui:field="structure1"></div>
                    <div ui:field="structure2"></div>
                    <br/>
                    <h5 ui:field="structure3" style="padding-bottom:15px;">
                        <span class="{style.contactUs}" ui:field="contactButton">contact us</span>
                    </h5>
                </div>
            </div>
        </div>
    </g:HTMLPanel>
</ui:UiBinder>