<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
             xmlns:g='urn:import:com.google.gwt.user.client.ui'
             xmlns:m='urn:import:gwt.material.design.client.ui'
             xmlns:mhtml='urn:import:gwt.material.design.client.ui.html'
             xmlns:kpi='urn:import:com.edatasite.workforce.gwt.core.client.ui'>
    <g:HTMLPanel ui:field="panel">
        <m:MaterialCollapsible styleName="collapsible--arrows">
            <m:MaterialCollapsibleItem>
                <m:MaterialCollapsibleHeader>
                    <mhtml:Span ui:field="collapsibleHeader"/>
                </m:MaterialCollapsibleHeader>

                <m:MaterialCollapsibleBody>
                    <g:HTMLPanel styleName="form-group">
                        <mhtml:Label ui:field="jobTitleLabel" styleName="form-group__label"/>
                        <g:TextBox ui:field="jobTitle"/>
                    </g:HTMLPanel>

                    <g:HTMLPanel styleName="form-group">
                        <div class="input-field">
                            <mhtml:Label ui:field="descriptionLabel" styleName="form-group__label"/>
                            <g:TextArea visibleLines="2" ui:field="description"/>
                        </div>
                    </g:HTMLPanel>

                    <g:HTMLPanel styleName="form-group form-group--inline">
                        <g:HTMLPanel styleName="form-group__item">
                            <mhtml:Label ui:field="startDateLabel" styleName="form-group__label"/>
                            <kpi:DatePicker ui:field="startDate"/>
                        </g:HTMLPanel>
                        <g:HTMLPanel styleName="form-group__item">
                            <mhtml:Label ui:field="endDateLabel" styleName="form-group__label"/>
                            <kpi:DatePicker ui:field="endDate"/>
                        </g:HTMLPanel>
                    </g:HTMLPanel>

                    <g:HTMLPanel styleName="form-group">
                        <mhtml:Label ui:field="statusLabel" styleName="form-group__label"/>
                        <kpi:DataListBox ui:field="status"/>
                    </g:HTMLPanel>

                </m:MaterialCollapsibleBody>
            </m:MaterialCollapsibleItem>
        </m:MaterialCollapsible>

        <m:MaterialCollapsible styleName="collapsible--arrows">
            <m:MaterialCollapsibleItem>
                <m:MaterialCollapsibleHeader>
                    <mhtml:Span ui:field="collapsibleHeader2"/>
                </m:MaterialCollapsibleHeader>

                <m:MaterialCollapsibleBody>
                    <g:HTMLPanel styleName="form-group">
                        <mhtml:Label ui:field="numberLabel" styleName="form-group__label"/>
                        <g:HTMLPanel ui:field="numberDiv"/>
                    </g:HTMLPanel>

                    <g:HTMLPanel styleName="form-group">
                        <mhtml:Label ui:field="positionLabel" styleName="form-group__label"/>
                        <kpi:DataListBox ui:field="position"/>
                    </g:HTMLPanel>

                    <g:HTMLPanel styleName="form-group">
                        <mhtml:Label ui:field="managerLabel" styleName="form-group__label"/>
                        <kpi:DataListBox ui:field="manager"/>
                    </g:HTMLPanel>
                </m:MaterialCollapsibleBody>
            </m:MaterialCollapsibleItem>
        </m:MaterialCollapsible>
    </g:HTMLPanel>
</ui:UiBinder>