<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
             xmlns:g='urn:import:com.google.gwt.user.client.ui'
             xmlns:m.html="urn:import:gwt.material.design.client.ui.html"
             xmlns:m='urn:import:gwt.material.design.client.ui'>
    <g:HTMLPanel ui:field="vatReturnPanel">
        <section style="background-color=#fff;">
            <div class="container">

                <header style="">
                    <div class="bordertext" ui:field="statusContainer">
                        <p ui:field="statusText">Unfiled</p>
                    </div>
                    <div class="header-info">
                        <div class="header-info-row">
                            <p>Tax Period</p>
                            <m.html:Paragraph ui:field="periodParagraph"/>
                        </div>
                        <div class="header-info-row">
                            <p>Tax Basis</p>
                            <p ui:field="taxBasis">Accrual</p>
                        </div>
                    </div>
                    <div class="header-button">
                        <m:MaterialLink ui:field="fileButton"/>
                    </div>
                </header>
                <main>
                    <div class="title-section">
                        <h3 ui:field="companyName"/>
                        <h1>VAT Return</h1>
                        <m.html:Paragraph ui:field="periodAsReportTitle"/>
                    </div>

                    <div class="table-section">
                        <g:HTMLPanel ui:field="tableContainer" styleName="table">
                            <table>
                                <thead ui:field="salesThead">
                                    <tr>
                                        <th>№</th>
                                        <th>DESCRIPTION</th>
                                        <th>BOX#</th>
                                        <th>AMOUNT</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>1</td>
                                        <td>VAT due on sales and other outputs</td>
                                        <td>Box 1</td>
                                        <td id="BOX_1"></td>
                                    </tr>
                                    <tr>
                                        <td>2</td>
                                        <td>VAT due from you (but not paid) on acquisitions of goods made in Northern Ireland from EU Member States</td>
                                        <td>Box 2</td>
                                        <td id="BOX_2"></td>
                                    </tr>
                                    <tr style="background-color: #f5f5f5;">
                                        <td>3</td>
                                        <td>Total VAT due</td>
                                        <td>Box 3</td>
                                        <td id="BOX_3"></td>
                                    </tr>
                                    <tr>
                                        <td>4</td>
                                        <td>VAT reclaimed in the period on purchases and other inputs (including acquisitions in Northern Ireland from EU member states)</td>
                                        <td>Box 4</td>
                                        <td id="BOX_4"></td>
                                    </tr>
                                    <tr style="background-color: #f5f5f5;">
                                        <td>5</td>
                                        <td>VAT payable or reclaimable</td>
                                        <td>Box 5</td>
                                        <td id="BOX_5"></td>
                                    </tr>
                                    <tr>
                                        <td>6</td>
                                        <td>Your total sales excluding VAT</td>
                                        <td>Box 6</td>
                                        <td id="BOX_6"></td>
                                    </tr>
                                    <tr>
                                        <td>7</td>
                                        <td>Your total purchases excluding VAT</td>
                                        <td>Box 7</td>
                                        <td id="BOX_7"></td>
                                    </tr>
                                    <tr>
                                        <td>8</td>
                                        <td>Total value of dispatches of goods and related costs (excluding VAT) from Northern Ireland to EU Member States</td>
                                        <td>Box 8</td>
                                        <td id="BOX_8"></td>
                                    </tr>
                                    <tr>
                                        <td>9</td>
                                        <td>Total value of acquisitions of goods and related costs (excluding VAT) made in Northern Ireland from EU Member States</td>
                                        <td>Box 9</td>
                                        <td id="BOX_9"></td>
                                    </tr>
                                </tbody>
                                <tbody ui:field="salesTbody" />
                            </table>
                        </g:HTMLPanel>
                    </div>
                </main>
            </div>
        </section>
    </g:HTMLPanel>
</ui:UiBinder>
