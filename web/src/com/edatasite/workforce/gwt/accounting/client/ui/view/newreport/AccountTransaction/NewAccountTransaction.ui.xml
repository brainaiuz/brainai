<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
             xmlns:g='urn:import:com.google.gwt.user.client.ui'
             xmlns:groupBox="urn:import:com.edatasite.workforce.gwt.core.client.ui.components.groupBox">

    <g:HTMLPanel styleName="pageContent_reporting" ui:field="exportPanel">

        <div class="fixed-filters-panel-wrapper">
            <groupBox:SectionBoxPanel ui:field="headerPanel"/>
        </div>

        <div id="mainContent" class="inputs_sm table_tree">
            <div class="textPanel clearfix delimit_top">
            </div>
            <table class="table table30 table--small-cells table-condensed table-bordered table-hover table_report table_leftIndex table_report_sections valign_middle accounting-table"
                   cellspacing="0" cellpadding="0">
                <thead class="point_affix_top text-nowrap" ui:field="tableHead"/>
                <tbody class="category_set" ui:field="tableBody"/>
            </table>
            <g:HTMLPanel ui:field="noResultMessage" styleName="section-box box-bg--1 center-align-Cell"></g:HTMLPanel>
        </div>
    </g:HTMLPanel>
</ui:UiBinder>