<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
             xmlns:g='urn:import:com.google.gwt.user.client.ui'
             xmlns:gBox="urn:import:com.edatasite.workforce.gwt.core.client.ui.components.groupBox">

    <g:HTMLPanel styleName="pageContent_reporting" ui:field="exportExcelPanel">

        <div class="fixed-filters-panel-wrapper">
            <gBox:SectionBoxPanel ui:field="headerPanel"/>
        </div>

        <div id="mainContent" class="inputs_sm trial_balance_report_table">
            <div class="textPanel clearfix delimit_top">
                <table cellpadding="0" cellspacing="0"
                       class="table table-condensed table-bordered table_tree table_striped_cols table-hover table_report table_leftIndex table_report_sections">
                    <thead class="point_affix_top text-nowrap" ui:field="header">
                        <tr>
                            <th class="stickerCell text-left">
                                <div class="frame_affix_top" style="min-width: 50px;" ui:field="accountCodeText">Account Code</div>
                            </th>
                            <th class="stickerCell text-left">
                                <div class="frame_affix_top" style="min-width: 300px;" ui:field="accountNameText">Account Name</div>
                            </th>
                            <th class="stickerCell text-right">
                                <div class="frame_affix_top" style="min-width: 80px;" ui:field="beginningDebitText">Beginning Debit</div>
                            </th>
                            <th class="stickerCell text-right">
                                <div class="frame_affix_top" style="min-width: 80px;" ui:field="beginningCreditText">Beginning Credit</div>
                            </th>
                            <th class="stickerCell text-right">
                                <div class="frame_affix_top" style="min-width: 80px;" ui:field="debitText">Debit</div>
                            </th>
                            <th class="stickerCell text-right">
                                <div class="frame_affix_top" style="min-width: 80px;" ui:field="creditText">Credit</div>
                            </th>
                            <th class="stickerCell text-right">
                                <div class="frame_affix_top" style="min-width: 80px;" ui:field="endingDebitText">Ending Debit</div>
                            </th>
                            <th class="stickerCell text-right">
                                <div class="frame_affix_top" style="min-width: 80px;" ui:field="endingCreditText">Ending Credit</div>
                            </th>
                        </tr>
                    </thead>
                    <tbody ui:field="assetsGroup" class="category_set"/>
                    <tbody ui:field="liabilitiesGroup" class="category_set"/>
                    <tbody ui:field="equityGroup" class="category_set"/>
                    <tbody ui:field="revenueGroup" class="category_set"/>
                    <tbody ui:field="expensesGroup" class="category_set"/>
                    <tbody ui:field="totalField"/>
                </table>
                <g:HTMLPanel ui:field="noResultText" styleName="section-box box-bg--1 center-align-Cell"></g:HTMLPanel>
            </div>
        </div>
    </g:HTMLPanel>
</ui:UiBinder>
