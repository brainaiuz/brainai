<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
             xmlns:g='urn:import:com.google.gwt.user.client.ui'
             xmlns:groupBox="urn:import:com.edatasite.workforce.gwt.core.client.ui.components.groupBox">

    <g:HTMLPanel styleName="pageContent_reporting bt_area" ui:field="exportPanel">

        <div class="fixed-filters-panel-wrapper">
            <groupBox:SectionBoxPanel ui:field="headerPanel"/>
        </div>

        <div id="mainContent" class="inputs_sm">
            <div class="tab-content workarea_head_tabs_content textPanel">
                <table cellpadding="0" cellspacing="0"
                       class="table table-condensed table-bordered table_tree table_striped_cols table-hover table_report table_leftIndex table_report_sections">
                    <thead class="point_affix_top text-nowrap" ui:field="tableHeader">
                        <tr>
                            <th class="stickerCell text-left">
                                <div class="frame_affix_top" style="min-width: 200px;">
                                    <a href="#" ui:field="accountText">Account</a>
                                    <a class="fonticon-sort-alpha-asc state_origin" href="#"
                                       ui:field="sortByAccount"></a>
                                </div>
                            </th>
                            <th class="stickerCell text-right">
                                <div class="frame_affix_top" style="min-width: 100px;" ui:field="balanceText"></div>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="gross_total_row" ui:field="operatingTr"></tbody>
                    <tbody class="category_set expanded" ui:field="netProfit"></tbody>
                    <tbody class="category_set expanded" ui:field="currentAssets"></tbody>
                    <tbody class="category_set expanded" ui:field="prepayments"></tbody>
                    <tbody class="category_set expanded" ui:field="currentLability"></tbody>
                    <tbody class="gross_total_row" ui:field="operatingTotalTr"></tbody>

                    <tbody class="gross_total_row" ui:field="investingTr"></tbody>
                    <tbody class="category_set expanded" ui:field="deprication"></tbody>
                    <tbody class="category_set expanded" ui:field="fixedAsset"></tbody>
                    <tbody class="category_set expanded" ui:field="liability"></tbody>
                    <tbody class="category_set expanded" ui:field="nonCurrent"></tbody>
                    <tbody class="gross_total_row" ui:field="investingTotalTr"></tbody>

                    <tbody class="gross_total_row" ui:field="financingTr"></tbody>
                    <tbody class="category_set expanded" ui:field="longTermLability"></tbody>
                    <tbody class="category_set expanded" ui:field="equity"></tbody>
                    <tbody class="gross_total_row" ui:field="financingTotalTr"></tbody>

                    <tbody class="category_set" ui:field="netIncreaseDecreaseForPeriod">
                    </tbody>
                    <tbody class="category_set" ui:field="cashAtTheBeginningOfPeriod">
                    </tbody>
                    <tbody class="category_set" ui:field="cashAtTheEndOfPeriod">
                    </tbody>
                </table>
            </div>
        </div>
    </g:HTMLPanel>
</ui:UiBinder>
