<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
             xmlns:g='urn:import:com.google.gwt.user.client.ui'
             xmlns:groupBox="urn:import:com.edatasite.workforce.gwt.core.client.ui.components.groupBox">

    <g:HTMLPanel styleName="pageContent_reporting" ui:field="exportPanel">

        <div class="fixed-filters-panel-wrapper">
            <groupBox:SectionBoxPanel ui:field="headerPanel"/>
        </div>

        <div id="mainContent" class="inputs_sm table_tree">

            <table class="category_set table table--small-cells table-condensed table-bordered table_striped_cols table-hover table_report table_report_sections valign_middle table_leftIndex"
                   cellspacing="0" cellpadding="0">
                <thead class="point_affix_top text-nowrap">
                    <tr>
                        <th class="stickerCell text-left">
                            <div class="frame_affix_top" style="min-width: 150px;" ui:field="thType">Type</div>
                        </th>
                        <th class="stickerCell">
                            <div class="frame_affix_top" style="min-width: 100px;" ui:field="thEntryDate">Entry Date</div>
                        </th>
                        <th class="stickerCell">
                            <div class="frame_affix_top" style="min-width: 100px;" ui:field="thTransactionDate">Transaction Date</div>
                        </th>
                        <th class="stickerCell">
                            <div class="frame_affix_top" style="min-width: 100px;" ui:field="thName">Name</div>
                        </th>
                        <th class="stickerCell">
                            <div class="frame_affix_top" style="min-width: 100px;" ui:field="thNo">No.</div>
                        </th>
                        <th class="stickerCell text-right">
                            <div class="frame_affix_top" style="min-width: 100px;" ui:field="thQty">Qty</div>
                        </th>
                        <th class="stickerCell text-right">
                            <div class="frame_affix_top" style="min-width: 100px;" ui:field="thTransactionValue">Transaction Value</div>
                        </th>
                        <th class="stickerCell text-right">
                            <div class="frame_affix_top" style="min-width: 100px;" ui:field="thCostPerQty">Cost per Qty</div>
                        </th>
                        <th class="stickerCell text-right">
                            <div class="frame_affix_top" style="min-width: 100px;" ui:field="thQuantityOnHand">Quantity on Hand</div>
                        </th>
                        <th class="stickerCell text-right">
                            <div class="frame_affix_top" style="min-width: 120px;" ui:field="thBalanceValue"></div>
                        </th>
                    </tr>
                </thead>
                <tbody ui:field="tableBody">

                </tbody>
            </table>
            <h6 ui:field="infoText"></h6>
        </div>
    </g:HTMLPanel>
</ui:UiBinder>