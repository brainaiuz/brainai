<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
             xmlns:g='urn:import:com.google.gwt.user.client.ui'
             xmlns:form="urn:import:com.edatasite.workforce.gwt.core.client.ui.components.form"
             xmlns:html="urn:import:gwt.material.design.client.ui.html"
             xmlns:lookup="urn:import:com.edatasite.workforce.gwt.core.client.ui.lookup">
    <g:HTMLPanel ui:field="container">
        <div class="grid-row">
            <div class="col-12">
                <div class="form-group">
                    <html:Label ui:field="nameLabel" styleName="form-group__label"/>
                    <g:TextBox ui:field="txtName"/>
                </div>
                <form:FormGroup ui:field="typeInput"/>
                <div class="form-group">
                    <html:Label ui:field="descriptionLabel" styleName="form-group__label"/>
                    <g:TextArea ui:field="txtDescription"/>
                </div>
                <div class="form-group">
                    <html:Label ui:field="salesPriceLabel" styleName="form-group__label"/>
                    <g:TextBox ui:field="txtsalesPrice"/>
                </div>
                <div class="form-group">
                    <html:Label ui:field="salesAccountLabel" styleName="form-group__label"/>
                    <lookup:AccountsLookUp ui:field="salesAccountLookUp"/>
                </div>
                <form:FormGroup ui:field="purchasePriceInput"/>
                <form:FormGroup ui:field="purchaseAccountInput"/>
                <form:FormGroup ui:field="qtyInput"/>
                <form:FormGroup ui:field="warehouseInput"/>
                <form:FormGroup ui:field="assetInput"/>
                <form:FormGroup ui:field="asOfInput"/>
            </div>
        </div>
    </g:HTMLPanel>
</ui:UiBinder>