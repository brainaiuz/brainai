<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
             xmlns:g='urn:import:com.google.gwt.user.client.ui'
             xmlns:component='urn:import:com.edatasite.workforce.gwt.core.client.ui.components'
             xmlns:kpi='urn:import:com.edatasite.workforce.gwt.core.client.ui'
             xmlns:kpiaccounting='urn:import:com.edatasite.workforce.gwt.accounting.client.ui.view.accounting'
             xmlns:md='urn:import:gwt.material.design.client.ui'
             xmlns:mhtml='urn:import:gwt.material.design.client.ui.html'>
    <g:HTMLPanel ui:field="bodyPanel">
        <g:HTMLPanel styleName="grid-row">
            <g:HTMLPanel styleName="col-4">
                <g:HTMLPanel styleName="form-group">
                    <mhtml:Label styleName="form-group__label" ui:field="billOfEntryLabel"/>
                    <div class="form-group__content">
                        <mhtml:Label ui:field="billOfEntry"/><!--styleName="form-control"-->
                    </div>
                </g:HTMLPanel>
            </g:HTMLPanel>
            <g:HTMLPanel styleName="col-4">
                <g:HTMLPanel styleName="form-group">
                    <mhtml:Label styleName="form-group__label" ui:field="portCodeLabel"/>
                    <div class="form-group__content">
                        <mhtml:Label ui:field="portCode"/>
                    </div>
                </g:HTMLPanel>
            </g:HTMLPanel>
            <g:HTMLPanel styleName="col-4">
                <g:HTMLPanel styleName="form-group">
                    <mhtml:Label styleName="form-group__label" ui:field="billOfEntryDateLabel"/>
                    <div class="form-group__content">
                        <mhtml:Label ui:field="billOfEntryDate"/>
                        <!--<g:TextBox styleName="form-control" ui:field="billOfEntryDate"/>-->
                    </div>
                </g:HTMLPanel>
            </g:HTMLPanel>
        </g:HTMLPanel>
        <g:HTMLPanel styleName="grid-row">
            <g:HTMLPanel styleName="col-4">
                <g:HTMLPanel styleName="form-group">
                    <mhtml:Label styleName="form-group__label" ui:field="paidThroughLabel"/>
                    <div class="form-group__content">
                        <mhtml:Label ui:field="paidThrough"/>
                        <!--<kpi:DataListBox ui:field="paidThrough"/>-->
                    </div>
                </g:HTMLPanel>
            </g:HTMLPanel>
            <g:HTMLPanel styleName="col-4">
                <g:HTMLPanel styleName="form-group">
                    <mhtml:Label styleName="form-group__label" ui:field="referenceLabel"/>
                    <div class="form-group__content">
                        <mhtml:Label ui:field="reference"/>
                    </div>
                </g:HTMLPanel>
            </g:HTMLPanel>

        </g:HTMLPanel>
        <g:HTMLPanel styleName="grid-row">
            <g:HTMLPanel styleName="col-12">
                <g:HTMLPanel styleName="form-group">
                    <mhtml:Label styleName="form-group__label" ui:field="descriptionLabel"/>
                    <div class="form-group__content">
                        <mhtml:Label ui:field="description"/>
                    </div>
                </g:HTMLPanel>
            </g:HTMLPanel>
        </g:HTMLPanel>

        <g:FlowPanel ui:field="billOfEntryItems"/>

        <g:HTMLPanel styleName="grid-row">
            <g:HTMLPanel styleName="col-8">
                <g:HTMLPanel styleName="form-group">
                    <mhtml:Label styleName="form-group__label" text="Total Custom Duty + Additional Charges "
                                 ui:field="totalCustomDutyLabel"/>
                    <div class="form-group__content" ui:field="totalCustomDuty">
                        0.00
                    </div>
                </g:HTMLPanel>
            </g:HTMLPanel>
        </g:HTMLPanel>
        <g:HTMLPanel styleName="grid-row">
            <g:HTMLPanel styleName="col-8">
                <g:HTMLPanel styleName="form-group">
                    <mhtml:Label styleName="form-group__label" text="Total Tax Amount"
                                 ui:field="totalTaxLabel"/>
                    <div class="form-group__content" ui:field="totalTax">
                        0.00
                    </div>
                </g:HTMLPanel>
            </g:HTMLPanel>
        </g:HTMLPanel>
        <g:HTMLPanel styleName="grid-row">
            <g:HTMLPanel styleName="col-8">
                <g:HTMLPanel styleName="form-group">
                    <mhtml:Label styleName="form-group__label" text="Total Amount ( AED )"
                                 ui:field="totalAmountLabel"/>
                    <div class="form-group__content" ui:field="totalAmount">
                        0.00
                    </div>
                </g:HTMLPanel>
            </g:HTMLPanel>
        </g:HTMLPanel>

    </g:HTMLPanel>
</ui:UiBinder>