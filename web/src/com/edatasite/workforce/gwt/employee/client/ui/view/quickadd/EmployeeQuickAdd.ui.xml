<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:mhtml="urn:import:gwt.material.design.client.ui.html"
             xmlns:kpi="urn:import:com.edatasite.workforce.gwt.core.client.ui">
    <g:HTMLPanel ui:field="panel">
        <div class="grid-row">
            <div class="col-12">
                <div class="form-group">
                    <mhtml:Label ui:field="firstnameLabel" styleName="form-group__label"/>
                    <g:TextBox ui:field="firstname"/>
                </div>
                <div class="form-group">
                    <mhtml:Label ui:field="lastnameLabel" styleName="form-group__label"/>
                    <g:TextBox ui:field="lastname"/>
                </div>
                <div class="form-group">
                    <mhtml:Label ui:field="emailLabel" styleName="form-group__label"/>
                    <g:TextBox ui:field="email"/>
                </div>

                <div class="form-group">
                    <mhtml:Label ui:field="departmentLabel" styleName="form-group__label"/>
                    <kpi:DataListBox ui:field="department"/>
                </div>

                <div class="form-group">
                    <mhtml:Label ui:field="positionLabel" styleName="form-group__label"/>
                    <kpi:DataListBox ui:field="position"/>
                </div>

                <div class="form-group">
                    <mhtml:Label ui:field="roleLabel" styleName="form-group__label"/>
                    <kpi:DataListBox ui:field="employeeRole"/>
                </div>
            </div>
        </div>

    </g:HTMLPanel>
</ui:UiBinder>