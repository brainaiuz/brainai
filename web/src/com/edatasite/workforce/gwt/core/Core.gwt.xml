<module>

    <inherits name='com.google.gwt.http.HTTP'/>
    <inherits name="com.google.gwt.user.User"/>
    <inherits name="com.google.gwt.i18n.I18N"/>
    <inherits name='com.google.gwt.json.JSON'/>
    <inherits name='com.google.gwt.user.RemoteServiceObfuscateTypeNames'/>
    <inherits name="com.edatasite.workforce.gwt.documents.DocumentsEmpty"/>
    <inherits name="com.edatasite.workforce.gwt.importfile.ImportFileEmpty"/>
    <inherits name="com.edatasite.workforce.gwt.messagecenter.MessageCenterMainEmpty"/>
    <inherits name='com.allen_sauer.gwt.dnd.gwt-dnd'/>
    <inherits name='com.google.gwt.gen2.table.Table'/>
    <inherits name="org.realityforge.gwt.websockets.WebSockets"/>
    <inherits name='com.googlecode.gwt.crypto.Crypto'/>
    <inherits name="com.google.gwt.xml.XML"/>
    <inherits name="de.novanic.eventservice.GWTEventService"/>
    <inherits name="com.edatasite.workforce.gwt.materialkanban.MaterialKanban"/>
    <inherits name="com.edatasite.workforce.gwt.chart.Chart"/>
    <inherits name='com.google.code.gwt.crop.GWTCropper'/>
    <inherits name="com.github.nmorel.gwtjackson.GwtJackson"/>

    <inherits name="org.moxieapps.gwt.highcharts.Highcharts"/>

    <inherits name="gwt.material.design.GwtMaterialDesignBasic"/>
    <inherits name="gwt.material.design.addins.GwtMaterialAddinsBase"/>
    <inherits name="gwt.material.design.incubator.AddinsIncubator"/>

    <set-property name="user.agent" value="gecko1_8,safari"/>
    <set-configuration-property name="UiBinder.useSafeHtmlTemplates" value="true"/>
    <set-configuration-property name='xsiframe.failIfScriptTag' value='FALSE'/>

    <generate-with
            class="com.edatasite.workforce.gwt.core.client.rpc.binding.KpiServiceInterfaceProxyGenerator">
        <when-type-assignable class="com.google.gwt.user.client.rpc.RemoteService"/>
    </generate-with>
</module>
