<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
             xmlns:g='urn:import:com.google.gwt.user.client.ui'
             xmlns:component='urn:import:com.edatasite.workforce.gwt.core.client.ui.components'
             xmlns:kpi='urn:import:com.edatasite.workforce.gwt.core.client.ui'
             xmlns:mhtml='urn:import:gwt.material.design.client.ui.html'
             xmlns:lookup="urn:import:com.edatasite.workforce.gwt.core.client.ui.lookup">
    <g:HTMLPanel ui:field="panel">
        <g:HTMLPanel styleName="invite-users">
            <div class="configure-email margin-bottom-sm">
                <div class="bar-stack invited-users">
                    <mhtml:Div ui:field="gmailPanel" class="bar" visible="false">
                        <mhtml:Span ui:field="gmailIcon" styleName="bar__icon"/>
                        <mhtml:Span ui:field="gmailText"/>
                    </mhtml:Div>
                    <mhtml:Div ui:field="outlookPanel" class="bar" visible="false">
                        <mhtml:Span ui:field="outlookIcon" styleName="bar__icon"/>
                        <mhtml:Span ui:field="outlookText"/>
                    </mhtml:Div>
                    <mhtml:Div ui:field="defaultPanel" class="bar" visible="false">
                        <mhtml:Span ui:field="defaultIcon" styleName="bar__icon"/>
                        <mhtml:Span ui:field="defaultText"/>
                    </mhtml:Div>
                </div>
            </div>

            <g:HTMLPanel ui:field="defaultDetailPanel" visible="false">
                <div class="panel">
                    <div class="panel__body">
                        <div class="form-group">
                            <mhtml:Label ui:field="emailLabel" styleName="form-group__label"/>
                            <g:TextBox ui:field="email"/>
                        </div>
                        <div class="form-group">
                            <mhtml:Label ui:field="passwordLabel" styleName="form-group__label"/>
                            <g:PasswordTextBox ui:field="password"/>
                        </div>
                        <div class="form-group">
                            <mhtml:Label ui:field="loginLabel" styleName="form-group__label"/>
                            <g:TextBox ui:field="login"/>
                        </div>
                        <div class="form-group">
                            <mhtml:Label ui:field="fromNameLabel" styleName="form-group__label"/>
                            <g:TextBox ui:field="fromName"/>
                        </div>
                        <div class="grid-row">
                            <div class="col-9">
                                <div class="form-group">
                                    <mhtml:Label ui:field="imapHostLabel" styleName="form-group__label"/>
                                    <lookup:EmailHostLookUp ui:field="imapServerHost"/>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="form-group">
                                    <mhtml:Label ui:field="imapPortLabel" styleName="form-group__label"/>
                                    <g:TextBox ui:field="imapPort"/>
                                </div>
                            </div>
                        </div>
                        <div class="grid-row">
                            <div class="col-9">
                                <div class="form-group">
                                    <mhtml:Label ui:field="smtpHostLabel" styleName="form-group__label"/>
                                    <lookup:EmailHostLookUp ui:field="smptServerHost"/>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="form-group">
                                    <mhtml:Label ui:field="smtpPortLabel" styleName="form-group__label"/>
                                    <g:TextBox ui:field="smtpPort"/>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-group__label"/>
                            <component:KpiSwitcher ui:field="performSmtp"/>
                        </div>
                        <div class="form-group">
                            <label class="form-group__label"/>
                            <component:KpiSwitcher ui:field="copySent"/>
                        </div>
                        <kpi:wfmButton.buttonUtils.WfmButton2 ui:field="testConBtn" styleName="btn btn-block btn--primary"/>
                    </div>
                </div>
            </g:HTMLPanel>

            <g:HTMLPanel ui:field="additionalPanel" styleName="bar-stack invited-users">
                <div class="form-group">
                    <label class="form-group__label"/>
                    <component:KpiSwitcher ui:field="defaultBox"/>
                </div>
                <div class="form-group">
                    <label class="form-group__label"/>
                    <component:KpiSwitcher ui:field="corporate"/>
                </div>
                <div class="form-group">
                    <label class="form-group__label"/>
                    <component:KpiSwitcher ui:field="active"/>
                </div>
            </g:HTMLPanel>
        </g:HTMLPanel>

    </g:HTMLPanel>
</ui:UiBinder>
