<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
             xmlns:g='urn:import:com.google.gwt.user.client.ui'
        >
    <g:HTMLPanel styleName="form-horizontal inputs_sm grid_gutter_thin">
        <div class="form-group">
            <label class="col-md-4 control-label" style="float: left; margin-right: 5px;">Site Url:</label>

            <div class="col-md-6">
                <g:TextBox  debugId="reportname" ui:field="name"/>
                <g:HTML ui:field="error"/>
            </div>
        </div>

        <div class="form-group">
            <label class="col-md-4 control-label" style="float: left; margin-right: 5px;">Example:</label>
            <div class="col-md-6">
                https://contoso.sharepoint.com
            </div>
        </div>

    </g:HTMLPanel>
</ui:UiBinder>