<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:mhtml="urn:import:gwt.material.design.client.ui.html"
             xmlns:kpi="urn:import:com.edatasite.workforce.gwt.core.client.ui">
    <g:HTMLPanel>
        <g:HTMLPanel addStyleNames="form-group">
            <mhtml:Label class="form-group__label" ui:field="label" text="ATTACHMENTS UPLOAD"/>

            <div class="form-upload">
                <mhtml:Div class="btn-upload" ui:field="attachButton">
                    <kpi:WfmFormPanel action="/action/CreateAttachment" method="POST" ui:field="form" encoding="multipart/form-data">
                        <g:FileUpload debugId="btn-upload-2"  ui:field="uploadFile"/>
                    </kpi:WfmFormPanel>
                    <mhtml:Div class="btn-upload__icon">
                        <mhtml:Italic class="ficon--attachment"/>
                    </mhtml:Div>
                </mhtml:Div>
            </div>
        </g:HTMLPanel>

        <mhtml:Div class="" ui:field="filePanel"/>

    </g:HTMLPanel>
</ui:UiBinder>
