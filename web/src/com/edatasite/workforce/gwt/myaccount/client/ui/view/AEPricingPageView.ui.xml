<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
             xmlns:g='urn:import:com.google.gwt.user.client.ui'
        >


    <g:HTMLPanel>
        <div class="container aePricing international" >
        <dn-display-mode ng-model="displayMode"></dn-display-mode>
        <article id="post">
            <form id="plan-customizing">

                <div class="row">
                    <div class="col-md-12" style="width:92%">
                        <h5 class="planSubTitle" style="margin-top: 15px;">CHOOSE ONE OF THE OFFERED BUNDLES OR <a href="#customize">CUSTOMISE</a>
                            YOUR OWN SUBSCRIPTION PLAN</h5>

                        <h1 class="planSubTitle">SMART BUNDLES</h1>
                    </div>
                    <!-- End of Right sidebar, sign up form -->
                </div>
               <!-- <div class="row">
                    <div class="col-xs-12 col-md-4 col-md-offset-4">
                        <div class="pricing-type-selectbox">
                            <h4 class="text-center">Choose Country</h4>
                            <div class="img-flag"><img src="myaccount/images/uae.png"/></div>
                            <select class="form-control">
                                <option value="international">International</option>
                                <option value="uae">UAE</option>
                            </select>
                        </div>
                    </div>
                </div>-->
                <section id="UAEPricing" class="uae-pricing">
                    <div class="bundle-fields">
                        <div class="row">
                            <div class="col-xs-12 col-md-4" style="width:29%">
                                <div class="panel panel-default">
                                    <div class="panel-heading">Basic</div>
                                    <div class="panel-body">
                                        <ul class="list-group">
                                            <li class="list-group-item">
                                                <div class="price"><sup>AED</sup> 1920 <span>/Year</span></div>
                                            </li>
                                            <li class="list-group-item">Active Users: 1</li>
                                            <li class="list-group-item padding-left-30">Discount:</li>
                                            <li class="list-group-item">ESS Users: 1</li>
                                            <li class="list-group-item padding-left-30">Discount:</li>
                                            <li class="list-group-item">Project Management</li>
                                            <li class="list-group-item">HRMS and Payroll</li>
                                            <li class="list-group-item">CRM</li>
                                            <li class="list-group-item">Accounting and Finance</li>
                                            <li class="list-group-item inside-btn">
                                                <g:Anchor ui:field="basicBtn">Try for
                                                    free</g:Anchor>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-12 col-md-4" style="width:29%">
                                <div class="panel panel-default">
                                    <div class="panel-heading">Pro</div>
                                    <div class="panel-body">
                                        <ul class="list-group">
                                            <li class="list-group-item">
                                                <div class="price"><sup>AED</sup> 7644 <span>/Year</span></div>
                                            </li>
                                            <li class="list-group-item">Active Users: 2</li>
                                            <li class="list-group-item padding-left-30">Discount: 15%</li>
                                            <li class="list-group-item">ESS Users: 10</li>
                                            <li class="list-group-item padding-left-30">Discount: 10%</li>
                                            <li class="list-group-item">Project Management</li>
                                            <li class="list-group-item">HRMS and Payroll</li>
                                            <li class="list-group-item">CRM</li>
                                            <li class="list-group-item">Accounting and Finance</li>
                                            <li class="list-group-item inside-btn">
                                                <g:Anchor  ui:field="proBtn">Try for
                                                    free</g:Anchor>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-12 col-md-4" style="width:29%">
                                <div class="panel panel-default">
                                    <div class="panel-heading">Enterprise</div>
                                    <div class="panel-body">
                                        <ul class="list-group">
                                            <li class="list-group-item">
                                                <div class="price"><sup>AED</sup> 28110 <span>/Year</span></div>
                                            </li>
                                            <li class="list-group-item">Active Users: 5</li>
                                            <li class="list-group-item padding-left-30">Discount: 15%</li>
                                            <li class="list-group-item">ESS Users: 100</li>
                                            <li class="list-group-item padding-left-30">Discount: 25%</li>
                                            <li class="list-group-item">Project Management</li>
                                            <li class="list-group-item">HRMS and Payroll</li>
                                            <li class="list-group-item">CRM</li>
                                            <li class="list-group-item">Accounting and Finance</li>
                                            <li class="list-group-item inside-btn">
                                                <g:Anchor  ui:field="enterpriseBtn" >Try for
                                                    free</g:Anchor>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="customize-uae-plan">
                        <div class="row plan-heading" >
                            <div class="col-md-12" style="width:92.3% !important">
                                <div class="panel panel-default">
                                    <div id="customize" class="panel-heading">Customise your plan</div>
                                </div>
                            </div>
                        </div>
                        <div class="row plan-body" style="width:100%">
                            <div class="col-md-4 col-xs-12" style="padding-left:16px;width:30%">
                                <div class="panel panel-default">
                                    <div class="panel-body">
                                        <div class="table-responsive">
                                            <table class="table">
                                                <thead>
                                                    <tr>
                                                        <th colspan="2" class="text-center">Number of Users</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr>
                                                        <td class="text-left" style="width: 70%">Active Users</td>
                                                        <td class="text-right"><input type="number" ui:field="activeUser" style="width: 70%;" min="0" value="0"
                                                                                      class="form-control" /></td>
                                                    </tr>
                                                    <tr>
                                                        <td class="text-left" style="width: 70%">ESS Users</td>
                                                        <td class="text-right"><input type="number" min="0" value="0"
                                                                                      ui:field="essUsers" style="width: 70%;"
                                                                                      class="form-control"  /></td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-8 col-xs-12" style="width:62%!important;">
                                <div class="panel panel-default">
                                    <div class="panel-body">
                                        <div class="table-responsive">
                                            <table class="table">
                                                <thead>
                                                    <tr>
                                                        <th colspan="2" class="text-center">Per user/year billed
                                                            annually
                                                        </th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr>
                                                        <td class="text-left">AED</td>
                                                        <td class="text-right">
                                                            <g:Label ui:field="activeTotal"></g:Label>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td class="text-left">AED</td>
                                                        <td class="text-right">
                                                            <g:Label ui:field="essTotal"></g:Label>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                                <div class="well overall-price"> <g:Label ui:field="totalPrice">Total: AED 0</g:Label> </div>
                                <g:Anchor  ui:field="customizeBtn" >Buy Now</g:Anchor>

                            </div>

                        </div>

                    </div>
                </section>
            </form>


        </article>
        <!-- #post-## -->

        </div>
    </g:HTMLPanel>
</ui:UiBinder>