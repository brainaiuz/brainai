<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
             xmlns:g='urn:import:com.google.gwt.user.client.ui'
             xmlns:kpi='urn:import:com.edatasite.workforce.gwt.core.client.ui'
             xmlns:mhtml='urn:import:gwt.material.design.client.ui.html'>
    <g:HTMLPanel ui:field="panel">
        <g:HTMLPanel styleName="form-group">
            <mhtml:Label ui:field="titleLabel" styleName="form-group__label"/>
            <g:TextBox ui:field="title"/>
        </g:HTMLPanel>

        <g:HTMLPanel styleName="form-group">
            <mhtml:Label ui:field="assigneeLabel" styleName="form-group__label"/>
            <kpi:DataListBox ui:field="assignee"/>
        </g:HTMLPanel>

        <g:HTMLPanel styleName="form-group">
            <mhtml:Label ui:field="statusLabel" styleName="form-group__label"/>
            <kpi:DataListBox ui:field="status"/>
        </g:HTMLPanel>

        <g:HTMLPanel styleName="form-group">
            <mhtml:Label ui:field="questionLabel" styleName="form-group__label"/>
            <g:TextArea ui:field="question"/>
        </g:HTMLPanel>

        <g:HTMLPanel styleName="form-group">
            <mhtml:Label ui:field="answerLabel" styleName="form-group__label"/>
            <g:TextArea ui:field="answer"/>
        </g:HTMLPanel>
    </g:HTMLPanel>
</ui:UiBinder>