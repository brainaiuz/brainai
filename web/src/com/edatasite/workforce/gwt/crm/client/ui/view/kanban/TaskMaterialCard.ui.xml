<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:m="urn:import:gwt.material.design.client.ui"
             xmlns:mhtml="urn:import:gwt.material.design.client.ui.html">

    <m:MaterialCard styleName="wg_canban__card kanban-board-item" shadow="1" backgroundColor="WHITE">
        <m:MaterialPanel styleName="wg_canban__card-status" ui:field="priorityColor"></m:MaterialPanel>
        <m:MaterialCardContent styleName="wg_canban__entry">
            <m:MaterialPanel styleName="wg_canban__entry-info">
                <m:MaterialPanel styleName="wg_canban__entry-title">
                    <m:MaterialLink ui:field="taskName" styleName="wg_canban__entry-name"/>
                    <m:MaterialLabel ui:field="duration" styleName=""/>
                    <m:MaterialPanel styleName="wg_canban__user-name">
                        <m:MaterialLabel ui:field="assignees" styleName=""/>
                    </m:MaterialPanel>
                </m:MaterialPanel>
            </m:MaterialPanel>

            <!--<m:MaterialPanel styleName="wg_canban__entry-contacts">
                <m:MaterialPanel styleName="wg_canban__user-activities" >&lt;!&ndash;ui:field="typePanel"&ndash;&gt;
                    <m:MaterialLink styleName="dropdown-button"/>
                </m:MaterialPanel>
                &lt;!&ndash;<mhtml:UnorderedList>
                    &lt;!&ndash;<mhtml:ListItem ui:field="liCall"></mhtml:ListItem>
                    <mhtml:ListItem ui:field="liEmail"></mhtml:ListItem>&ndash;&gt;
                </mhtml:UnorderedList>&ndash;&gt;
            </m:MaterialPanel>-->
        </m:MaterialCardContent>

        <m:MaterialCardAction styleName="wg_canban__card-footer" ui:field="actionAndProjectNamePanel">
            <m:MaterialPanel styleName="wg_canban__user">
                <m:MaterialPanel styleName="wg_canban__user-content">
                    <m:MaterialPanel styleName="wg_canban__user-notes" ui:field="notesPanel">

                    </m:MaterialPanel>
                    <!--                    <m:MaterialPanel styleName="wg_canban__user-activities" ui:field="priorityPanel">-->
                    <!--                        <m:MaterialLink styleName="dropdown-button"/>-->
                    <!--                    </m:MaterialPanel>-->
                    <m:MaterialPanel styleName="wg_canban__user-name">
                        <m:MaterialLabel styleName="MaterialLabel" ui:field="projectName"/>
                    </m:MaterialPanel>
                </m:MaterialPanel>
                <m:MaterialPanel styleName="wg_canban__user-actions" ui:field="actionsLinkPanel">
                    <m:MaterialPanel styleName="dropdown-kit--arrow--below">
                        <m:MaterialLink ui:field="actionsLink" styleName="dropdown-button">
                            <mhtml:Icon styleName="ficon--more-horiz"/>
                        </m:MaterialLink>
                    </m:MaterialPanel>
                </m:MaterialPanel>
            </m:MaterialPanel>
        </m:MaterialCardAction>

    </m:MaterialCard>

</ui:UiBinder>