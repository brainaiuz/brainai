<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
             xmlns:g='urn:import:com.google.gwt.user.client.ui'
             xmlns:kpi='urn:import:com.edatasite.workforce.gwt.core.client.ui'
             xmlns:mhtml='urn:import:gwt.material.design.client.ui.html'>
    <g:HTMLPanel ui:field="panel">

        <g:HTMLPanel styleName="form-group">
            <mhtml:Label ui:field="subjectLabel" styleName="form-group__label"/>
            <g:TextBox ui:field="subject"/>
        </g:HTMLPanel>

        <g:HTMLPanel styleName="form-group">
            <mhtml:Label ui:field="descriptionLabel" styleName="form-group__label"/>
            <g:TextArea ui:field="description"/>
        </g:HTMLPanel>

        <g:HTMLPanel styleName="form-group">
            <mhtml:Label ui:field="reporterLabel" styleName="form-group__label"/>
            <g:HTMLPanel ui:field="reporter"/>
        </g:HTMLPanel>

        <g:HTMLPanel styleName="form-group">
            <mhtml:Label ui:field="assigneeLabel" styleName="form-group__label"/>
            <g:HTMLPanel ui:field="assignee"/>
        </g:HTMLPanel>

        <g:HTMLPanel styleName="form-group" ui:field="statusContainer">
            <mhtml:Label ui:field="statusLabel" styleName="form-group__label"/>
            <kpi:DataListBox ui:field="status"/>
        </g:HTMLPanel>

        <g:HTMLPanel styleName="form-group">
            <mhtml:Label ui:field="typeLabel" styleName="form-group__label"/>
            <kpi:DataListBox ui:field="type"/>
        </g:HTMLPanel>

        <!--<g:HTMLPanel styleName="form-group">-->
            <!--<mhtml:Label ui:field="priorityLabel" styleName="form-group__label"/>-->
            <!--<kpi:DataListBox ui:field="priority"/>-->
        <!--</g:HTMLPanel>-->

    </g:HTMLPanel>
</ui:UiBinder>