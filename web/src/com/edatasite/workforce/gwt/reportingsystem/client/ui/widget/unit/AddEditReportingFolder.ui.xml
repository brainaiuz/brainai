<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
             xmlns:g='urn:import:com.google.gwt.user.client.ui'
             xmlns:d='urn:import:com.edatasite.workforce.gwt.core.client.ui'
             xmlns:w="urn:import:com.edatasite.workforce.gwt.core.client.ui">
    <g:HTMLPanel styleName="form-horizontal inputs_sm grid_gutter_thin">

        <div class="form-group">
            <label class="form-group__label" ui:field="folderNameLabel">
                Folder name:
                <span style="color:red">*</span>
            </label>

            <div class="form-group__content">
                <input type="text" maxlength="255" class="form-control" ui:field="name"/>
                <g:HTML ui:field="errorName"/>
            </div>
        </div>

        <div class="form-group">
            <label class="form-group__label"
                   for="gwt-debug-desctiption" ui:field="descriptionLabel">Description:
            </label>
            <div class="form-group__content">
                <w:TextArea2 debugId="desctiption" ui:field="description" />
            </div>
        </div>
        <div class="form-group">
            <label class="form-group__label"
                   for="gwt-debug-desctiption" ui:field="folderTypeLabel">Folder type:
            </label>

            <div class="form-group__content">
                <d:DataListBox ui:field="folderType" styleName="form-control" withoutNullLabel="true"/>
            </div>
        </div>
        <div class="form-group">
            <label class="form-group__label"
                   for="gwt-debug-desctiption" ui:field="moduleTypeLabel">Module type:
            </label>

            <div class="form-group__content">
                <d:DataListBox ui:field="moduleType" styleName="form-control" withoutNullLabel="true"/>
                <g:HTML ui:field="errorModuleType"/>
            </div>
        </div>

    </g:HTMLPanel>
</ui:UiBinder>