<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
             xmlns:g='urn:import:com.google.gwt.user.client.ui'
             xmlns:w="urn:import:gwt.material.design.addins.client.combobox"
        >
    <g:HTMLPanel>
        <div class="form-group">
            <label class="form-group__label" ui:field="nameLabel"
                   for="gwt-debug-reportname">Name:
            </label>

            <div class="form-group__content">
                <g:TextBox styleName="form-control" debugId="reportname"
                           ui:field="name"/>
                <g:HTML ui:field="error"/>
            </div>
        </div>

        <div class="form-group">
            <label class="form-group__label" ui:field="descLabel"
                   for="gwt-debug-desctiption">Description:
            </label>

            <div class="form-group__content">
                <g:TextArea styleName="form-control" debugId="desctiption"
                           ui:field="desctiption"/>
            </div>
        </div>

        <div class="form-group">
            <label class="form-group__label" ui:field="foldersLabel"
                   for="gwt-debug-folder">Folders:
            </label>

            <div class="form-group__content child-width-holder">

                <w:MaterialComboBox ui:field="folder" styleName="form-control"/>

            </div>
        </div>
    </g:HTMLPanel>
</ui:UiBinder>