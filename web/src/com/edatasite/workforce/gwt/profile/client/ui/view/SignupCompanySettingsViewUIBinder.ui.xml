<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
             xmlns:g='urn:import:com.google.gwt.user.client.ui'
             xmlns:b="urn:import:com.edatasite.workforce.gwt.core.client.ui.wfmButton.buttonUtils"
             xmlns:w='urn:import:com.edatasite.workforce.gwt.core.client.ui'>
    <g:HTMLPanel>
        <ul class="collapsible--panels collapsible--arrows-left collapsible collapsible--gwt required">
            <li class="slideDown-box group active">
                <div class="collapsible-header active">
                    <a style="cursor: pointer;">
                        <span ui:field="welcome"></span>
                    </a>
                </div>
                <div class="collapsible-body">
                    <div class="grid-row">
                        <div class="col-12">
                            <div class="form-group">
                                <div class="form-group__label">
                                    <g:Label ui:field="companyNameLabel"></g:Label>
                                </div>
                                <div class="form-group__content">
                                    <g:TextBox ui:field="companyName"></g:TextBox>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="form-group">
                                <div class="form-group__label">
                                    <g:Label ui:field="languageLabel"></g:Label>
                                </div>
                                <div class="form-group__content">
                                    <w:DataListBox ui:field="language"></w:DataListBox>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <b:WfmButton2 ui:field="saveButton"></b:WfmButton2>
                        </div>
                    </div>
                </div>
            </li>
        </ul>

    </g:HTMLPanel>
</ui:UiBinder>