<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
             xmlns:g='urn:import:com.google.gwt.user.client.ui'
             xmlns:m='urn:import:gwt.material.design.client.ui'
             xmlns:m.html="urn:import:gwt.material.design.client.ui.html"
             xmlns:components="urn:import:com.edatasite.workforce.gwt.core.client.ui.components">
    <g:HTMLPanel>
        <div class="form-row">
            <div class="col">
                <div class="form-group">
                    <div class="form-group__label"/>
                    <div class="form-group__content">
                        <components:KpiCheckBox ui:field="vatRegistered"/>
                    </div>
                </div>
            </div>
        </div>
        <g:HTMLPanel styleName="form-row" ui:field="pnlContainer">
            <g:HTMLPanel styleName="col" ui:field="pnlVatConfigContainer">
                <div class="form-group">
                    <div class="form-group__label">
                        <m.html:Span ui:field="trnLabel"/>
                    </div>
                    <div class="form-group__content form-row">
                        <div class="col-2">
                            <g:TextBox ui:field="txtTaxIdDisplayName"/>
                        </div>
                        <div class="col-4">
                            <g:TextBox ui:field="txtTaxIdNumber"/>
                        </div>
                        <div class="col-auto">
                            <m:MaterialLink ui:field="validateTaxId"/>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <div class="form-group__label">
                        <m.html:Span ui:field="tinLabel"/>
                    </div>
                    <div class="form-group__content form-row">
                        <div class="col-2">
                            <g:TextBox ui:field="txtTinDisplayName"/>
                        </div>
                        <div class="col-2">
                            <g:TextBox ui:field="txtTinIdNumber"/>
                        </div>
                        <div class="col-2">
                            <g:TextBox ui:field="otpCode"/>
                        </div>
                        <div class="col-auto">
                            <m:MaterialLink ui:field="validateTIN"/>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <div class="form-group__label">
                        <m.html:Span ui:field="reverseChargeLabel"/>
                    </div>
                    <div class="form-group__content">
                        <components:KpiCheckBox ui:field="reverseCharge"/>
                        <br/>
                        <small class="help-block help-block-dark">Enable this option if you are doing business with other GCC/Non-GCC countries and also for reverse charge handling.</small>
                    </div>
                </div>
                <div class="form-group">
                    <div class="form-group__label">
                        <m.html:Span ui:field="vatRegisteredOnLabel"/>
                    </div>
                    <m.html:Div class="form-group__content form-row" ui:field="vatRegisteredOnContainer"/>
                </div>
                <div class="form-group">
                    <div class="form-group__label">
                        <m.html:Span ui:field="generateDateLabel"/>
                    </div>
                    <m.html:Div class="form-group__content form-row" ui:field="taxGenerateDateContainer"/>
                </div>
                <div class="form-group">
                    <div class="form-group__label">
                        <m.html:Span ui:field="taxPeriodLabel"/>
                    </div>
                    <m.html:Div class="form-group__content form-row" ui:field="taxPeriodContainer"/>
                </div>
            </g:HTMLPanel>
        </g:HTMLPanel>
    </g:HTMLPanel>
</ui:UiBinder>