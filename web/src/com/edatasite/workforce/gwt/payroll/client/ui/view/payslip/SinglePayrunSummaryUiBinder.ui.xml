<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
             xmlns:g='urn:import:com.google.gwt.user.client.ui'
             xmlns:m='urn:import:gwt.material.design.client.ui.html'
             xmlns:w='urn:import:com.edatasite.workforce.gwt.core.client.ui'
             xmlns:i='urn:import:com.edatasite.workforce.gwt.invoice.client.ui.view.components'
             xmlns:groupBox="urn:import:com.edatasite.workforce.gwt.core.client.ui.components.groupBox"
             xmlns:c='urn:import:com.edatasite.workforce.gwt.core.client.ui.components.groupBox'>
    <g:HTMLPanel>
        <div class="width-limiter">
            <div>
                <div class="grid-row">
                    <div class="col">
                        <div class="grid-row">
                            <div class="col-4">
                                <div class="grid-row">
                                    <m:Div styleName="col-6" ui:field="employeePanel"/>
                                    <m:Div styleName="col-6" ui:field="projectPanel"/>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="grid-row">
                                    <m:Div styleName="col-6" ui:field="processDatePanel"/>
                                    <m:Div styleName="col-6" ui:field="frequencyPanel"/>
                                </div>
                            </div>
                            <m:Div styleName="col-4" ui:field="paymentMethodPanel"/>
                        </div>
                        <div class="grid-row">
                            <div class="col-4">
                                <div class="grid-row">
                                    <m:Div styleName="col-8" ui:field="periodPanel"/>
                                    <m:Div styleName="col-4" ui:field="sendNotifyPanel"/>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="grid-row">
                                    <m:Div styleName="col-6" ui:field="fromDatePanel"/>
                                    <m:Div styleName="col-6" ui:field="toDatePanel"/>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="grid-row">
                                    <m:Div styleName="col-6" ui:field="approverPanel"/>
                                    <m:Div styleName="col-6" ui:field="showMorePanel"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="mb-4 mt-5">
            <div class="grid-row">
                <div class="col-6">
                    <m:Div class="column item-table__container" ui:field="paymentsDiv"/>
                </div>
                <div class="col-6">
                    <m:Div class="column item-table__container" ui:field="deductionsDiv"/>
                    <m:Div class="column item-table__container" ui:field="taxDiv"/>
                    <div class="mb-4 mt-4">
                        <div class="grid-row file--SinglePayrunSummaryUIBinder">
                            <div class="col"></div>
                            <m:Div styleName="col-auto offset-1" ui:field="totalPanel"/>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </g:HTMLPanel>
</ui:UiBinder>
