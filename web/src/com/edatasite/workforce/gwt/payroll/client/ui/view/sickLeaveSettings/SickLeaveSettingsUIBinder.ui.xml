<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
             xmlns:g='urn:import:com.google.gwt.user.client.ui'
             xmlns:f='urn:import:com.edatasite.workforce.gwt.core.client.ui.components.form'
             xmlns:w='urn:import:com.edatasite.workforce.gwt.core.client.ui.wfmButton.buttonUtils'
             xmlns:mh="urn:import:gwt.material.design.client.ui.html">
    <g:HTMLPanel>
        <div class="panel-box panel-box--right">
            <div class="panel-box__item">
                <w:WfmButton2 ui:field="saveButton"/>
            </div>
        </div>
        <ul class="collapsible--panels collapsible--arrows-left collapsible collapsible--gwt required">
            <li class="slideDown-box group active">
                <div class="collapsible-header active">
                    <a style="cursor: pointer;">
                        <mh:Span ui:field="titleLabel">$$label:TITLE$$</mh:Span>
                    </a>
                </div>
                <div class="collapsible-body">
                    <div class="grid-row">
                        <div class="col-6">
                            <f:FormGroup ui:field="fullSickDays"/>
                            <f:FormGroup ui:field="halfSickDays"/>
                            <f:FormGroup ui:field="noSickDdays"/>
                        </div>
                        <div class="col-6">
                            <f:FormGroup ui:field="serviceMinPeriod"/>
                            <f:FormGroup ui:field="sickLeaveCategoy"/>
                            <f:FormGroup ui:field="paymentType"/>
                            <f:FormGroup ui:field="allowance"/>
                        </div>
                    </div>
                </div>
            </li>
        </ul>
    </g:HTMLPanel>
</ui:UiBinder>