<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
             xmlns:g='urn:import:com.google.gwt.user.client.ui'
             xmlns:m='urn:import:gwt.material.design.client.ui'
>
    <g:HTMLPanel ui:field="container">
        <div class="grid-row">
            <div class="col-12">
                <div class="form-group">
                    <m:html.Div ui:field="paymentPanel" class="form-group__content"/>
                </div>

                <m:html.Div ui:field="deductionDiv"
                            style="line-height: inherit; text-transform: uppercase; padding: 2rem 0 1.3rem 0;">
                    <g:Label ui:field="deductionLabel" visible="false"/>
                </m:html.Div>
                <div class="form-group">
                    <m:html.Div ui:field="deductionPanel" class="form-group__content"/>
                </div>

                <div style="line-height: inherit; text-transform: uppercase; padding: 2rem 0 1.3rem 0;">
                    <g:Label ui:field="taxLabel" visible="false"/>
                </div>
                <div class="form-group">
                    <m:html.Div ui:field="taxPanel" class="form-group__content"/>
                </div>

                <m:html.Div ui:field="employerContributionDiv"
                            style="line-height: inherit; text-transform: uppercase; padding: 2rem 0 1.3rem 0;">
                    <g:Label ui:field="employerContributionLabel" visible="false"/>
                </m:html.Div>
                <div class="form-group">
                    <m:html.Div ui:field="employerContributionPanel" class="form-group__content"/>
                </div>
            </div>
        </div>
    </g:HTMLPanel>
</ui:UiBinder>