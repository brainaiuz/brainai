<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:m="urn:import:gwt.material.design.client.ui"
             xmlns:mhtml="urn:import:gwt.material.design.client.ui.html"
             xmlns:kpi="urn:import:com.edatasite.workforce.gwt.core.client.ui">
    <g:HTMLPanel ui:field="panel" styleName="fadeInEl invite-user-form">
        <div class="panel">
            <div class="panel__body">
                <div class="pseudo-input bg-grey-contrast" style="text-transform: none;">
                    <mhtml:Span ui:field="header"/>
                </div>
                <div class="grid-row">
                    <div class="col-6">
                        <div class="form-group">
                            <mhtml:Label ui:field="firstnameLabel" styleName="form-group__label"/>
                            <g:TextBox ui:field="firstname"/>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            <mhtml:Label ui:field="lastnameLabel" styleName="form-group__label"/>
                            <g:TextBox ui:field="lastname"/>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <mhtml:Label ui:field="emailLabel" styleName="form-group__label"/>
                    <g:TextBox ui:field="email"/>
                </div>

                <div class="grid-row invite-user-form__role">
                    <div class="col-9">
                        <div class="form-group">
                            <mhtml:Label ui:field="roleLabel" styleName="form-group__label"/>
                            <kpi:DataListBox ui:field="employeeRole"/>
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="form-group">
                            <mhtml:Label ui:field="essLabel" styleName="form-group__label"/>
                            <div class="form-group__content pt-2"><g:CheckBox ui:field="ess"/></div>
                        </div>
                    </div>
                </div>
                <kpi:wfmButton.buttonUtils.WfmButton2 ui:field="inviteBtn" styleName="btn btn-block btn--primary"/>
            </div>
        </div>
    </g:HTMLPanel>
</ui:UiBinder>