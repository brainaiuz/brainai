    <!--<property name="parent.dir" value=".."/>-->
    <property name="bin" value="..\bin"/>
    <property name="gwt.home" value="..\gwtclib"/>
    <property name="tomcat.dir" value="..\Tomcat9libs"/>

    <!--<property name="result.dir" value="..\multischema.export"/>-->

    <!--Overriden-->
    <property name="gwt.dir" value="../TempGWT"/>
    <property name="gwtcopt" value=" -XdisableCastChecking  -XdisableClassMetadata"/>
    <property name="soyc" value=""/>
    <property name="extra" value=""/>


    <property name="outlookIntegration.dir" value="..\OutlookIntegration"/>

    <import file="All_build.xml"/>

    <path id="gwt.compiler.classpath">
        <pathelement location="src"/>

        <!--<pathelement location="../cs/src"/>-->
        <pathelement location="../reporting/src"/>
        <pathelement location="../bin"/>
        <pathelement location="../WfpWidgetContainer/src"/>
        <pathelement location="../war/WEB-INF/classes"/>
        <fileset dir="${gwtc.lib}"/>
    </path>


    <patternset id="ignored.files">
        <exclude name="**/CVS/**"/>
        <exclude name="**/SCCS/**"/>
        <exclude name="**/RCS/**"/>
        <exclude name="**/rcs/**"/>
        <exclude name="**/.DS_Store/**"/>
        <exclude name="**/.svn/**"/>
    </patternset>

    <patternset id="compiler.resources">
        <include name="**/?*.properties"/>
        <include name="**/?*.xml"/>
        <include name="**/?*.gif"/>
        <include name="**/?*.png"/>
        <include name="**/?*.jpeg"/>
        <include name="**/?*.jpg"/>
        <include name="**/?*.html"/>
        <include name="**/?*.dtd"/>
        <include name="**/?*.tld"/>
        <include name="**/?*.ott"/>
        <include name="**/?*.p12"/>
    </patternset>


    <path id="project.class.path">
        <pathelement path="${java.class.path}/"/>
        <fileset dir="${basedir}/lib">
            <include name="**/*.jar"/>
        </fileset>


        <fileset dir="${tomcat.dir}">
            <include name="*.jar"/>
        </fileset>

        <fileset dir="${gwt.home}">
            <include name="*.jar"/>
        </fileset>
    </path>

    <!--//////////////////////////// Build All ////////////////////////////////////////////////////////////-->
    <target name="z4_buildAll" depends="z1_compileServerSide, z2_compileAllUI, z3_CreateWar"/>

    <target name="z4_buildTransmitNotify" depends="z4_buildAll, z9_transmit"/>

    <target name="z4_buildServerCreateWar" depends="z1_compileServerSide, z3_CreateWar"/>

    <target name="z4_buildServerCreateWarTransmit" depends="z1_compileServerSide, z3_CreateWar, z9_transmit"/>

    <target name="z4_createWarTransmit" depends="z3_CreateWar, z9_transmit"/>

    <target name="z1_compileServerSide">
        <mkdir dir="${bin}"/>
        <javac destdir="${bin}" includes="**" includeantruntime="false"
               fork="true"
               debug="on" debuglevel="lines,vars,source"
               source="17"
               memoryinitialsize="256m"
               memorymaximumsize="1524m"
               encoding="utf-8">
            <src path="${basedir}/src"/>

            <src path="../WfpWidgetContainer/src"/>


            <!--<src path="../cs/src"/>-->
            <src path="../reporting/src"/>
            <classpath refid="project.class.path"/>
        </javac>


        <!--<copy todir="${bin}">
            <fileset dir="../cs/src">
                <patternset refid="compiler.resources"/>
                <patternset refid="ignored.files"/>
                <type type="file"/>
            </fileset>
        </copy>-->

        <copy todir="${bin}">
            <fileset dir="../reporting/src">
                <patternset refid="compiler.resources"/>
                <patternset refid="ignored.files"/>
                <type type="file"/>
            </fileset>
        </copy>

        <copy todir="${bin}">
            <fileset dir="${basedir}/src">
                <patternset refid="compiler.resources"/>
                <patternset refid="ignored.files"/>
                <type type="file"/>
            </fileset>
        </copy>


        <copy todir="${bin}">
            <fileset dir="../WfpWidgetContainer/src">
                <patternset refid="compiler.resources"/>
                <patternset refid="ignored.files"/>
                <type type="file"/>
            </fileset>
        </copy>


    </target>

    <target name="z2_compileAllUI" depends="All"/>

    <target name="z3_CreateWar">


