<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
</head>
<body>
<div align="center"><h2 style="font-style:italic;">Eжедневная оповещения</h2></div>
<p>Уважаемый Музаффар Карабаев , </p>
<p>Обратите внимание, что &nbsp; <strong>$today</strong> </p>
<div style="padding-left:30px;">
  <p><strong>Компании $newSignUpersCount </strong> подписали 
  <p><strong>Пользователи $totalUsers</strong> использовали систему 
  <p><strong>Компании $empAddedCompaniesCount</strong> добавили Сотрудников <strong>$companyAddedEmployeesCount</strong>
  <p><strong>Компании $projectAddedCompaniesCount</strong> создали Проекты <strong>$companyAddedProjectsCount</strong>
  <p><strong>Компании $taskAddedCompaniesCount</strong> создали Задачи <strong>$companyAddedTasksCount </strong>
  <p><strong>Компании $timesheetUsedCompaniesCount</strong> зарегистрировали время для Задач <strong>$timesheetUsedTasksCount</strong>  
</div>
Пожалуйста, смотрите детали ниже:

<h3 style="color:#000066"><u><strong>Новый Знак uppers </strong>:</u></h3>
<table border="0" width="100%" cellspacing="0" align="center" id="table2" style="border: solid 1px #979B98;">
	<thead>
		<tr >
			<th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">Название компании</th>
			<th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">Индустрия</th>
			<th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">Адрес</th>
			<th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">Администратор</th>
		</tr>
	</thead>
	<tbody>
		#foreach($company in $newSignUPers)
		<tr align="center">
			<td style="border: solid 1px #979B98;">$company.getCompany().getName()</td>
			<td style="border: solid 1px #979B98;">
			#if($company.getCompany().getWorkArea().getName())
			$company.getCompany().getWorkArea().getName()
			#end
			</td>
			<td style="border: solid 1px #979B98;">
			    #if($company.getCompany().getAddress1() )
					$company.getCompany().getAddress1()
				#end

				#if($company.getCompany().getAddress2() )
					<br> $company.getCompany().getAddress2()
				#end

				#if($company.getCompany().getCity() )
				    <br> $company.getCompany().getCity(),
				#end
				$company.getCompany().getCountryZone().getCountry().getName()
			</td>
			<td style="border: solid 1px #979B98;">
			#foreach($admin in $company.getCompanyAdmin())
				$admin.getName() <br> $admin.getEmail()
			#end
			</td>
		</tr>
		#end
	</tbody>
</table>


<h3 style="color:#000066"><u><strong>Компании, которые использовали $productName сегодня</strong></u></h3>
<table border="0" width="100%" cellspacing="0" align="center" id="table2" style="border: solid 1px #979B98;">
	<thead>
		<tr>
			<th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">Название компании</th>
			<th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">Индустрия</th>
			<th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">Адрес</th>
			<th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">Используемые Разделы</th>
		</tr>
	</thead>
	<tbody>
		#foreach($companyReport in $logReport)
		<tr align="center">
			<td style="border: solid 1px #979B98;">$companyReport.getCompany().getName()</td>
			<td style="border: solid 1px #979B98;">
			#if($companyReport.getCompany().getWorkArea().getName())
			$companyReport.getCompany().getWorkArea().getName()
			#end
			</td>
			<td style="border: solid 1px #979B98;">
			#if($companyReport.getCompany().getAddress1())
				$companyReport.getCompany().getAddress1()
			#end
			#if($companyReport.getCompany().getAddress2())
				<br> $companyReport.getCompany().getAddress2()
			#end
            #if($companyReport.getCompany().getCity())
				<br> $companyReport.getCompany().getCity(),
			#end
			$companyReport.getCompany().getCountryZone().getCountry().getName()
			</td>
			<td style="border: solid 1px #979B98;">
				#foreach($sections in $companyReport.getSections())
					$sections &nbsp;section <br>
				#end
			</td>
		</tr>
		#end
	</tbody>
</table>

<h3 style="color:#000066"><u><strong>Компании, которые вошли в систему, но не использовали раздела сегодня</strong></u></h3>
<table border="0" width="100%" cellspacing="0" align="center" id="table2" style="border: solid 1px #979B98;">
	<thead>
		<tr >
			<th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">Название компании</th>
			<th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">Индустрия</th>
			<th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">Адрес</th>
			<th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">Администратор</th>
		</tr>
	</thead>
	<tbody>
		#foreach($company in $onlyLoginUsedUsers)
		<tr align="center">
			<td style="border: solid 1px #979B98;">$company.getCompany().getName()</td>
			<td style="border: solid 1px #979B98;">
			#if($company.getCompany().getWorkArea().getName())
			$company.getCompany().getWorkArea().getName()
			#end
			</td>
			<td style="border: solid 1px #979B98;">
			    #if($company.getCompany().getAddress1() )
					$company.getCompany().getAddress1()
				#end

				#if($company.getCompany().getAddress2() )
					<br> $company.getCompany().getAddress2()
				#end

				#if($company.getCompany().getCity() )
				    <br> $company.getCompany().getCity(),
				#end
				$company.getCompany().getCountryZone().getCountry().getName()
			</td>
			<td style="border: solid 1px #979B98;">
			#foreach($admin in $company.getCompanyAdmin())
				$admin.getName() <br> $admin.getEmail()
			#end
			</td>
		</tr>
		#end
	</tbody>
</table>
<h3 style="color:#000066"><u><strong>Обновления компании</strong></u></h3>
<table border="0" width="100%" cellspacing="0" align="center" id="table3" style="border: solid 1px #979B98;">
	<thead>
		<tr>
			<th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">Название компании</th>
			<th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">Новые Сотрудники</th>
			<th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">Новые Проекты</th>
			<th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">Новые Задачи</th>
			<th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">Новые Отделы</th>
			<th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">Новые Клиенты</th>
			<th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">Новые Проблемы</th>
			<th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">Записи времени</th>
		</tr>
	</thead>
	<tbody>
		#foreach($companyReport in $logReport)
		<tr align="center">
			<td style="border: solid 1px #979B98;">$companyReport.getCompany().getName()</td>
			<td style="border: solid 1px #979B98;">$companyReport.getEmployees()</td>
			<td style="border: solid 1px #979B98;">$companyReport.getProjects()</td>
			<td style="border: solid 1px #979B98;">$companyReport.getTasks()</td>
			<td style="border: solid 1px #979B98;">$companyReport.teams</td>
			<td style="border: solid 1px #979B98;">$companyReport.clients</td>
			<td style="border: solid 1px #979B98;">$companyReport.issues</td>
			<td style="border: solid 1px #979B98;">$companyReport.getTimesheet()</td>
		</tr>
		#end
	</tbody>
</table>

<h3 style="color:#000066"><u><strong>Оценка продуктивности</strong></u></h3>
<table border="0" width="100%" cellspacing="0" align="center" id="table3" style="border: solid 1px #979B98;">
	<thead>
		<tr>
			<th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">Название компании</th>
			<th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">Инициируемая Оценка</th>
			<th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">Рассмотренная Оценка</th>
			<th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">Расчетная Оценка</th>
			<th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">Просматриваемая Оценка</th>
		</tr>
	</thead>
	<tbody>
		#foreach($record in $cPAReport)
		<tr align="center">
			<td style="border: solid 1px #979B98;">$record.getCompany().getName()</td>
			<td style="border: solid 1px #979B98;">$record.initiated</td>
			<td style="border: solid 1px #979B98;">$record.reviewed</td>
			<td style="border: solid 1px #979B98;">$record.rated</td>
			<td style="border: solid 1px #979B98;">$record.approved</td>
		</tr>
		#end
	</tbody>
</table>

</body>
</html>