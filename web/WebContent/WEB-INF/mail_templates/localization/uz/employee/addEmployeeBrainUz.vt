<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">

<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width">
    <style>
        @import url('https://fonts.googleapis.com/css?family=Montserrat');

        body,
        table.body,
        h1,
        h2,
        h3,
        h4,
        h5,
        h6,
        p,
        td,
        th {
            color: #2c3a45;
            font-family: Montserrat, Helvetica Neue, Helvetica, Arial, sans-serif;
            font-weight: normal;
            padding: 0;
            margin: 0;
            Margin: 0;
            text-align: left;
            line-height: 1.5;
        }
    </style>

</head>

<body
    style="-moz-box-sizing: border-box; -ms-text-size-adjust: 100%; -webkit-box-sizing: border-box; -webkit-text-size-adjust: 100%; Margin: 0; box-sizing: border-box; color: #2c3a45; font-family: Montserrat, Helvetica Neue, Helvetica, Arial, sans-serif !important; font-size: 16px; font-weight: normal; line-height: 1.5; margin: 0; min-width: 100%; padding: 0; text-align: left; width: 100% !important;">

    <table class="body" cellpadding="0" cellspacing="0" border="0"
        style="Margin: 0; background: #eceff3; color: #2c3a45; font-family: Montserrat , Helvetica, Arial, sans-serif; font-size: 16px; font-weight: normal; height: 100%; line-height: 1.5; margin: 0; padding: 0; text-align: left; vertical-align: top; width: 100%;">
        <tbody>
            <tr style="padding: 0; text-align: left; vertical-align: top;">
                <td
                    style="Margin: 0; color: #2c3a45; font-family: Montserrat , Helvetica, Arial, sans-serif; font-size: 16px; font-weight: normal; line-height: 1.5; margin: 0; padding: 0; text-align: left; vertical-align: top;">
                    <table class="container" cellpadding="0" cellspacing="0" border="0"
                        style="Margin: 0 auto; margin: 0 auto; padding: 0; text-align: inherit; vertical-align: top; width: 634px;">
                        <tbody>
                            <tr style="padding: 0; text-align: left; vertical-align: top;">
                                <td
                                    style="Margin: 0; color: #2c3a45; font-family: Montserrat , Helvetica, Arial, sans-serif; font-size: 16px; font-weight: normal; line-height: 1.5; margin: 0; padding: 0; text-align: left; vertical-align: top;">

                                    <table class="row" cellspacing="0" cellpadding="0" border="0"
                                        style="border-collapse: separate; border-spacing: 17px 0; padding: 0; text-align: left; vertical-align: top; width: 100%;">
                                        <tbody>
                                            <tr style="padding: 0; text-align: left; vertical-align: middle;">
                                                <td valign="middle"
                                                    style="padding: 30px 0; text-align: left; width: 160px;">
                                                    <img src="$host/mainStyles/new-ui/images/emailTemplateService/brainLogoBlack.png"
                                                        alt="" border="0" width="200" height="70"
                                                        style="-ms-interpolation-mode: bicubic; display: block;">
                                                </td>
                                                <td valign="middle"
                                                    style="padding: 30px 0 30px 15px; text-align: left; color: #2c3a45; font-family: Montserrat, Helvetica, Arial, sans-serif; font-size: 13px; line-height: 1.5;">
                                                    Bir nechta biznesni <br>bitta platformadan boshqaring.
                                                </td>

                                            </tr>

                                        </tbody>
                                    </table>

                                    <table class="row" cellpadding="0" border="0" width="100%"
                                        style="border-collapse: separate; border-spacing: 17px 0; margin-bottom: 17px; padding: 0; text-align: left; vertical-align: top; width: 100%;">
                                        <tbody>
                                            <tr style="padding: 0; text-align: left; vertical-align: top;">
                                                <td valign="top"
                                                    style="Margin: 0; background-color: #2D3945; border-radius: 10px 10px 0 0; color: white; font-family: Montserrat , Helvetica, Arial, sans-serif; font-size: 16px; font-weight: normal; line-height: 1.5; margin: 0; padding: 30px 25px 0; text-align: left; vertical-align: top; width: 140px;">
                                                    <img style="-ms-interpolation-mode: bicubic; clear: both; display: block; margin-bottom: 20px; max-width: 100%; outline: none; text-decoration: none;"
                                                        src="$host/mainStyles/new-ui/images/emailTemplateService/message-icon.png"
                                                        alt="" border="0">
                                                    <div style=" line-height: 1.375; ">
                                                        $admin.getName()<p
                                                            style="color: #2BBE57; text-decoration:none;margin: 0;font-weight: bold">
                                                            taklif yubordi.</p>
                                                    </div>
                                                </td>
                                                <td valign="top"
                                                    style="Margin: 0; background-color: white; border-radius: 10px 10px 0 0; color: #2c3a45; font-family: Montserrat , Helvetica, Arial, sans-serif; font-size: 16px; font-weight: normal; line-height: 1.5; margin: 0; padding: 30px 25px 0; text-align: center; vertical-align: top;">

                                                    <div
                                                        style="font-size: 18px; margin-bottom: 15px; margin-top: 40px;">
                                                        Salom, $user.getName()!
                                                    </div>
                                                    <div
                                                        style="margin:0 auto; margin-bottom: 25px;color: #2c3a45;width: 80%;">
                                                        Sizga ma’lum qilamizki,
                                                        <b
                                                            style="text-align: center;margin:0; font-weight: bolder;">$admin.getName()</b>
                                                        siz uchun foydalanuvchi hisobi yaratdi.
                                                    </div>

                                                    <div style="text-align: center;">
                                                        <a href="$host/Myaccount.html?link=$link"
                                                            style="Margin: 0; color: #007de8; display: block; font-family: Montserrat , Helvetica, Arial, sans-serif; font-weight: normal; line-height: 1.5; margin: 0; margin-left: auto; margin-right: auto; padding: 0; text-align: left; text-decoration: none;">
                                                            <table border="0" cellpadding="0" cellspacing="0"
                                                                style="background-color: #2bbe57; border-radius: 5px; padding: 0; text-align: left; vertical-align: top;margin:auto;">
                                                                <tbody>
                                                                    <tr
                                                                        style="padding: 0; text-align: left; vertical-align: top;">
                                                                        <td align="center" valign="middle"
                                                                            style="Margin: 0; color: #FFFFFF; font-family: Montserrat , Helvetica, Arial, sans-serif; font-size: 16px; font-weight: bold; line-height: 55px; margin: auto; padding: 0; text-align: left; text-decoration: none; vertical-align: top;width: 160px;text-align: center">
                                                                            <a href="$host/auth/account/activation?key=$keyValue"
                                                                                target="_blank"
                                                                                style="Margin: 0; color: #FFFFFF;font-family: sans-serif !important;font-size:13px;font-weight:bold; margin: 0; padding: 0; text-align: center; text-decoration: none; display: block;">Faollashtirish</a>
                                                                        </td>
                                                                    </tr>
                                                                </tbody>
                                                            </table>
                                                        </a>
                                                    </div>


                                                </td>
                                            </tr>
                                            <tr style="padding: 0; text-align: left; vertical-align: top;">
                                                <td
                                                    style="Margin: 0; background-color: #2D3945; border-radius: 0 0 10px 10px; color: white; font-family: Montserrat , Helvetica, Arial, sans-serif; font-size: 16px; font-weight: normal; line-height: 1.5; margin: 0; padding: 15px 25px 20px; text-align: left; vertical-align: top; width: 140px;">
                                                    <div style="font-size: 13px; line-height: 1.85;">
                                                        <div style="">Hisob:</div>
                                                        <div
                                                            style="color: #b0bec8;overflow-wrap: break-word;word-wrap: break-word;max-width: 140px;">
                                                            <a href="#"
                                                                style="color: #b0bec8;overflow-wrap: break-word;word-wrap: break-word;max-width: 140px; text-decoration: none;">$user.getEmail()</a>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td
                                                    style="Margin: 0; background-color: white; border-radius: 0 0 10px 10px; color: #2c3a45; font-family: Montserrat , Helvetica, Arial, sans-serif; font-size: 16px; font-weight: normal; line-height: 1.5; margin: 0; padding: 15px 25px 20px; text-align: left; vertical-align: top;">

                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>


                                    <table class="row" cellpadding="0" border="0" width="100%"
                                        style="border-collapse: separate; border-spacing: 17px 0; margin-bottom: 17px; padding: 0; text-align: left; vertical-align: top; width: 100%;">
                                        <tbody>
                                            <tr style="padding: 0; text-align: left; vertical-align: top;">
                                                <td
                                                    style="Margin: 0; background-color: white; border-radius: 10px; color: #2c3a45; font-family: Montserrat , Helvetica, Arial, sans-serif; font-size: 16px; font-weight: normal; line-height: 1.5; margin: 0; padding: 30px 25px; text-align: left; vertical-align: top;">
                                                    <table cellpadding="0" cellspacing="0" border="0"
                                                        style="font-size: 16px; padding: 0; text-align: left; vertical-align: top;">
                                                        <tbody>
                                                            <tr
                                                                style="padding: 0; text-align: left; vertical-align: top;">
                                                                <td valign="top"
                                                                    style="Margin: 0; color: #2c3a45; font-family: Montserrat, Helvetica Neue, Helvetica, Arial, sans-serif; font-size: 16px; font-weight: normal; line-height: 1.5; margin: 0; padding: 0; text-align: left; vertical-align: top;">
                                                                <div style="font-size: 16px; line-height: 1.5; color: #2c3a45;">
  <div style="font-size: 18px; margin-bottom: 15px;">
    Savollaringiz bormi?
  </div>
  <div>
    Bizga&nbsp; <a href="mailto:$supportEmail"
      style="Margin: 0; color: #007de8; font-family: Montserrat, Helvetica Neue, Helvetica, Arial, sans-serif; font-weight: normal; line-height: 1.5; margin: 0; padding: 0; text-align: left; text-decoration: none;">info@brain.uz</a>
    manziliga yozing,
    <a href="#"
      style="Margin: 0; color: #2c3a45; font-family: Montserrat , Helvetica, Arial, sans-serif; font-weight: normal; line-height: 1.5; margin: 0; padding: 0; text-align: left; text-decoration: none;"> yoki jonli
      chat</a>
    orqali bog‘laning &nbsp;
  </div>
</div>

                                                                </td>

                                                                <td valign="top" width="250" align="right"
                                                                    style="Margin: 0; color: #2c3a45; font-family: Montserrat , Helvetica, Arial, sans-serif; font-size: 16px; font-weight: normal; line-height: 1.5; margin: 0; padding: 0; text-align: left; vertical-align: top;">
                                                                    <img src="$host/mainStyles/new-ui/images/emailTemplateService/brainAuto.png"
                                                                        width="178" height="162"
                                                                        style="-ms-interpolation-mode: bicubic; clear: both; display: block; margin-right: 10px; margin-left: auto; max-width: 100%; outline: none; text-decoration: none; width: auto;"
                                                                        alt="" border="0">
                                                                </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>


                                    <table class="row" cellpadding="0" border="0" width="100%"
                                        style="border-collapse: separate; border-spacing: 17px 0; padding: 0; text-align: left; vertical-align: top; width: 100%;">
                                        <tbody>
                                            <tr style="padding: 0; text-align: left; vertical-align: top;">
                                                <td
                                                    style="Margin: 0; color: #2c3a45; font-family: Montserrat , Helvetica, Arial, sans-serif; font-size: 12px; font-weight: normal; line-height: 1.5; margin: 0; padding: 0; padding-bottom: 30px; padding-left: 25px; padding-right: 25px; padding-top: 10px; text-align: center; vertical-align: top;">
                                                    <div style="opacity: 0.7;">© $currentYear Brain IT & Business,
                                                        Toshkent, Uzbekistan
                                                    </div>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>

                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
        </tbody>
    </table>


</body>

</html>