"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
</head>
<body>

<p>Beste $USER.getName(),</p>

<p>Dit is ter informatie dat de volgende activiteit is <b>verwijderd:</b></p>

<p><b>Activiteit details:</b></p>

<div style="background-color:lightblue; width:100%;">
<p>Titel: $EVENT_NAME</p>

<p>Omschrijving: $DESCRIPTION</p>

<p>Wanneer: $DATE</p>
</div>

<p>Waar: $WHERE</p>

$SHARED_WITH

</body>
</html>