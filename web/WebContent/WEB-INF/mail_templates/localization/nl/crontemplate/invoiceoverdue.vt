<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN"
        "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
</head>
<body>

<p>Beste $username,</p>

<p>De volgende facturen hebben hun vervaldatum gepasseerd:</p>

<table border="0" width="100%" cellspacing="0" style="border: solid 1px #365F91;color:#365F91;margin-top:20px;">
    <tr>
        <td bgcolor="#FFFFFF" style="border: solid 1px #365F91;width:50px;text-align:center;"><b>Factuurnummer</b></td>
        <td bgcolor="#FFFFFF" style="border: solid 1px #365F91;width:50px;text-align:center;"><b>Factuurdatum</b></td>
        <td bgcolor="#FFFFFF" style="border: solid 1px #365F91;width:50px;text-align:center;"><b>Vervaldatum</b></td>
        <td bgcolor="#FFFFFF" style="border: solid 1px #365F91;width:50px;text-align:center;"><b>Klant</b></td>
        <td bgcolor="#FFFFFF" style="border: solid 1px #365F91;width:50px;text-align:center;"><b>Totaal
            <br/>($baseCurrencyName)</b></td>
        <td bgcolor="#FFFFFF" style="border: solid 1px #365F91;width:50px;text-align:center;"><b>Totaal</b></td>
        <td bgcolor="#FFFFFF" style="border: solid 1px #365F91;width:50px;text-align:center;"><b>Betaald bedragt</b>
        </td>
        <td bgcolor="#FFFFFF" style="border: solid 1px #365F91;width:50px;text-align:center;"><b>&nbsp;&nbsp;&nbsp;&nbsp;</b>
        </td>
    </tr>
    #foreach($invoice in $invoices)
        <tr>
            <td bgcolor="#FFFFFF"
                style="border: solid 1pt; width:50px;text-align:left; font-color:#000000;">$invoice.getInvoiceNumber()</td>
            <td bgcolor="#FFFFFF"
                style="border: solid 1pt; width:50px;text-align:center; font-color:#000000;">$invoice.getInvoiceDateAsString()</td>
            <td bgcolor="#FFFFFF"
                style="border: solid 1pt; width:50px;text-align:center; font-color:#000000;">$invoice.getDueDateAsString()</td>
            <td bgcolor="#FFFFFF"
                style="border: solid 1pt; width:50px;text-align:left; font-color:#000000;">$invoice.getClientName()</td>
            <td bgcolor="#FFFFFF"
                style="border: solid 1pt; width:50px;text-align:right; font-color:#000000;">$invoice.getTotalAsString()</td>
            <td bgcolor="#FFFFFF"
                style="border: solid 1pt; width:50px;text-align:right; font-color:#000000;">$invoice.getTotalInInvoiceAsString()</td>
            <td bgcolor="#FFFFFF"
                style="border: solid 1pt; width:50px;text-align:right; font-color:#000000;">$invoice.getPaymentsAsString()</td>
            <td bgcolor="#FFFFFF" style="border: solid 1pt; width:50px;text-align:center; font-color:#000000;"><a
                    href="$host/Accounting.html?link=$invoice.getInvoiceURL()" title="View Overdue Invoice">Bekijken</a>
            </td>
        </tr>
    #end
</table>
<p>Klik <a href="$host/Accounting.html?link=$link" title="View Overdue Invoices List">hier</a>
    om de lijst met vervallen facturen te bekijken.</p>

<p>Als u niet op de link kunt klikken, kopieer dan de volgende regel naar uw web browser: </p>

<p><span style="color: #0033FF">$host/Accounting.html?link=$link</span></p>

</body>
</html>