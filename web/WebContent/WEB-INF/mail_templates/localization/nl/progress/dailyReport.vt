<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN""http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
</head>
<body>
<div align="center"><h2 style="font-style:italic;">DAGELIJKSE UPDATE</h2></div>
<p>Beste $recipient.getName() , </p>

<p>Sinds &nbsp; <strong>$today</strong></p>

<div style="padding-left:30px;">
    <p><strong>$newSignUpersCount </strong>bedrijven hebben zicht ingeschreven

    <p><strong>$totalUsers</strong> gebruikers hebben het systeem gebruikt

    <p><strong>$empAddedCompaniesCount</strong> bedrijven hebben <strong>$companyAddedEmployeesCount</strong>
        Medewerkers toegevoegd

    <p><strong>$projectAddedCompaniesCount</strong> bedrijven hebben <strong>$companyAddedProjectsCount</strong>
        Projecten toegevoegd

    <p><strong>$taskAddedCompaniesCount</strong> bedrijven hebben <strong>$companyAddedTasksCount </strong> Taken
        toegevoegd

    <p><strong>$timesheetUsedCompaniesCount</strong> bedrijven hebben <strong>$timesheetUsedTasksCount</strong> uren
        ingevoerd voor hun Taken
</div>
Details zijn als volgt:

<h3 style="color:#000066"><u><strong>Nieuwe aanmeldingen </strong>:</u></h3>
<table border="0" width="100%" cellspacing="0" align="center" id="table2" style="border: solid 1px #979B98;">
    <thead>
    <tr>
        <th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">
            Bedrijfsnaam
        </th>
        <th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">
            Branche
        </th>
        <th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">Adres
        </th>
        <th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">
            Beheerder
        </th>
    </tr>
    </thead>
    <tbody>
        #foreach($company in $newSignUPers)
        <tr align="center">
            <td style="border: solid 1px #979B98;">$company.getCompany().getName()</td>
            <td style="border: solid 1px #979B98;">
                #if($company.getCompany().getWorkArea().getName())
$company.getCompany().getWorkArea().getName()
#end
            </td>
            <td style="border: solid 1px #979B98;">
                #if($company.getCompany().getAddress1() )
                    $company.getCompany().getAddress1()
                #end

                #if($company.getCompany().getAddress2() )
                    <br> $company.getCompany().getAddress2()
                #end

                #if($company.getCompany().getCity() )
                    <br> $company.getCompany().getCity(),
                #end
                $company.getCompany().getCountryZone().getCountry().getName()
            </td>
            <td style="border: solid 1px #979B98;">
                #foreach($admin in $company.getCompanyAdmin())
                    $admin.getName() <br> $admin.getEmail()
                #end
            </td>
        </tr>
        #end
    </tbody>
</table>


<h3 style="color:#000066"><u><strong>Bedrijveb welke $productName vandaag gebruikt hebben</strong></u></h3>
<table border="0" width="100%" cellspacing="0" align="center" id="table2" style="border: solid 1px #979B98;">
    <thead>
    <tr>
        <th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">
            Bedrijfsnaam
        </th>
        <th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">
            Branche
        </th>
        <th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">Adres
        </th>
        <th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">
            Gebruikte modules
        </th>
    </tr>
    </thead>
    <tbody>
        #foreach($companyReport in $logReport)
        <tr align="center">
            <td style="border: solid 1px #979B98;">$companyReport.getCompany().getName()</td>
            <td style="border: solid 1px #979B98;">
                #if($companyReport.getCompany().getWorkArea().getName())
$companyReport.getCompany().getWorkArea().getName()
#end
            </td>
            <td style="border: solid 1px #979B98;">
                #if($companyReport.getCompany().getAddress1())
                    $companyReport.getCompany().getAddress1()
                #end
                #if($companyReport.getCompany().getAddress2())
                    <br> $companyReport.getCompany().getAddress2()
                #end
                #if($companyReport.getCompany().getCity())
                    <br> $companyReport.getCompany().getCity(),
                #end
                $companyReport.getCompany().getCountryZone().getCountry().getName()
            </td>
            <td style="border: solid 1px #979B98;">
                #foreach($sections in $companyReport.getSections())
                    $sections &nbsp;section <br>
                #end
            </td>
        </tr>
        #end
    </tbody>
</table>

<h3 style="color:#000066"><u><strong>Bedrijven die ingelogd hebben, maar geen modules hebben gebruikt</strong></u></h3>
<table border="0" width="100%" cellspacing="0" align="center" id="table2" style="border: solid 1px #979B98;">
    <thead>
    <tr>
        <th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">
            Bedrijfsnaam
        </th>
        <th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">
            Branche
        </th>
        <th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">Adres
        </th>
        <th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">
            Beheerder
        </th>
    </tr>
    </thead>
    <tbody>
        #foreach($company in $onlyLoginUsedUsers)
        <tr align="center">
            <td style="border: solid 1px #979B98;">$company.getCompany().getName()</td>
            <td style="border: solid 1px #979B98;">
                #if($company.getCompany().getWorkArea().getName())
$company.getCompany().getWorkArea().getName()
#end
            </td>
            <td style="border: solid 1px #979B98;">
                #if($company.getCompany().getAddress1() )
                    $company.getCompany().getAddress1()
                #end

                #if($company.getCompany().getAddress2() )
                    <br> $company.getCompany().getAddress2()
                #end

                #if($company.getCompany().getCity() )
                    <br> $company.getCompany().getCity(),
                #end
                $company.getCompany().getCountryZone().getCountry().getName()
            </td>
            <td style="border: solid 1px #979B98;">
                #foreach($admin in $company.getCompanyAdmin())
                    $admin.getName() <br> $admin.getEmail()
                #end
            </td>
        </tr>
        #end
    </tbody>
</table>
<h3 style="color:#000066"><u><strong>Bedrijfsupdates</strong></u></h3>
<table border="0" width="100%" cellspacing="0" align="center" id="table3" style="border: solid 1px #979B98;">
    <thead>
    <tr>
        <th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">
            Bedrijfsnaam
        </th>
        <th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">Nieuwe
            Medewerkers
        </th>
        <th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">Nieuwe
            Projecten
        </th>
        <th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">Nieuwe
            Taken
        </th>
        <th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">Nieuwe
            Afdelingen
        </th>
        <th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">Nieuwe
            Klanten
        </th>
        <th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">Nieuwe
            Issues
        </th>
        <th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">
            Ingevoerde tijdth>
    </tr>
    </thead>
    <tbody>
        #foreach($companyReport in $logReport)
        <tr align="center">
            <td style="border: solid 1px #979B98;">$companyReport.getCompany().getName()</td>
            <td style="border: solid 1px #979B98;">$companyReport.getEmployees()</td>
            <td style="border: solid 1px #979B98;">$companyReport.getProjects()</td>
            <td style="border: solid 1px #979B98;">$companyReport.getTasks()</td>
            <td style="border: solid 1px #979B98;">$companyReport.teams</td>
            <td style="border: solid 1px #979B98;">$companyReport.clients</td>
            <td style="border: solid 1px #979B98;">$companyReport.issues</td>
            <td style="border: solid 1px #979B98;">$companyReport.getTimesheet()</td>
        </tr>
        #end
    </tbody>
</table>

<h3 style="color:#000066"><u><strong>Prestatie beoordelingen</strong></u></h3>
<table border="0" width="100%" cellspacing="0" align="center" id="table3" style="border: solid 1px #979B98;">
    <thead>
    <tr>
        <th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">
            Bedrijfsnaam
        </th>
        <th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">
            Geïnitieerde Beoordelingen
        </th>
        <th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">
            Beoordeelde Beoordelingen
        </th>
        <th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">
            Gewaardeerde Beoordelingen
        </th>
        <th bgcolor="#A8A8A8" style="color:#fff; border-right: solid 1px #fff; border-bottom: solid 2px #787878">Bekeken
            Beoordelingen
        </th>
    </tr>
    </thead>
    <tbody>
        #foreach($record in $cPAReport)
        <tr align="center">
            <td style="border: solid 1px #979B98;">$record.getCompany().getName()</td>
            <td style="border: solid 1px #979B98;">$record.initiated</td>
            <td style="border: solid 1px #979B98;">$record.reviewed</td>
            <td style="border: solid 1px #979B98;">$record.rated</td>
            <td style="border: solid 1px #979B98;">$record.approved</td>
        </tr>
        #end
    </tbody>
</table>
</body>
</html>