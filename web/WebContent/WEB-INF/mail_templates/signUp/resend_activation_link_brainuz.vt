<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">

<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <meta name="viewport" content="width=device-width">
  <style>
    @import url('https://fonts.googleapis.com/css?family=Montserrat');

    body, table.body,
    h1, h2, h3, h4, h5, h6,
    p, td, th {
      color: #2c3a45;
      font-family: Montserrat, Helvetica Neue, Helvetica, Arial, sans-serif;
      font-weight: normal;
      padding: 0;
      margin: 0;
      text-align: left;
      line-height: 1.5;
    }
  </style>
</head>

<body style="
  -moz-box-sizing: border-box;
  -ms-text-size-adjust: 100%;
  -webkit-box-sizing: border-box;
  -webkit-text-size-adjust: 100%;
  box-sizing: border-box;
  color: #2c3a45;
  font-family: Montserrat, Helvetica Neue, Helvetica, Arial, sans-serif !important;
  font-size: 16px;
  font-weight: normal;
  line-height: 1.5;
  margin: 0;
  min-width: 100%;
  padding: 0;
  text-align: left;
  width: 100% !important;
  background: #eceff3;
">

  <!-- ============================================================
       OUTER WRAPPER
  ============================================================ -->
  <table class="body" cellpadding="0" cellspacing="0" border="0" width="100%"
    style="background: #eceff3; height: 100%; margin: 0; padding: 0; vertical-align: top;">
    <tbody>
      <tr>
        <td style="margin: 0; padding: 0; vertical-align: top;">

          <!-- ============================================================
               INNER CONTAINER (634px)
          ============================================================ -->
          <table class="container" cellpadding="0" cellspacing="0" border="0"
            style="margin: 0 auto; padding: 0; vertical-align: top; width: 634px;">
            <tbody>
              <tr>
                <td style="margin: 0; padding: 0; vertical-align: top;">


                  <!-- ============================================================
                       SECTION 1 — LOGO HEADER
                  ============================================================ -->
                  <table cellspacing="0" cellpadding="0" border="0" width="100%"
                    style="border-collapse: separate; border-spacing: 17px 0; padding: 0;">
                    <tbody>
                      <tr style="vertical-align: middle;">

                        <!-- Brain Logo -->
                        <td valign="middle" style="padding: 30px 0; width: 160px;">
                          <img
                            src="$host/mainStyles/new-ui/images/emailTemplateService/brainLogoBlack.png"
                            alt="Brain Logo" border="0" width="200" height="70"
                            style="-ms-interpolation-mode: bicubic; display: block;">
                        </td>

                        <!-- Tagline -->
                        <td valign="middle"
                          style="padding: 30px 0 30px 15px; font-size: 13px; line-height: 1.5;">
                          Bir platformadan bir nechta biznesni<br>boshqaring.
                        </td>

                      </tr>
                    </tbody>
                  </table>


                  <!-- ============================================================
                       SECTION 2 — ACTIVATION REMINDER CARD
                  ============================================================ -->
                  <table cellpadding="0" border="0" width="100%"
                    style="border-collapse: separate; border-spacing: 17px 0; margin-bottom: 17px; padding: 0;">
                    <tbody>

                      <!-- Card Top Row -->
                      <tr style="vertical-align: top;">

                        <!-- Left: Dark sidebar -->
                        <td valign="top" width="140"
                          style="background-color: #2D3945; border-radius: 10px 10px 0 0; color: white;
                                 padding: 30px 25px 0; vertical-align: top;">
                          <img
                            src="$host/mainStyles/new-ui/images/emailTemplateService/user.png"
                            alt="" border="0"
                            style="-ms-interpolation-mode: bicubic; display: block; margin-bottom: 20px; max-width: 100%;">
                          <div style="line-height: 1.375;">
                            Unutmang, <b style="color: #2BBE57;"><br>hisobingizni<br>faollashtiring</b>!
                          </div>
                        </td>

                        <!-- Right: White content area -->
                        <td valign="top"
                          style="background-color: white; border-radius: 10px 10px 0 0;
                                 padding: 30px 25px 30px; text-align: center; vertical-align: top;">

                          <!-- Greeting -->
                          <div style="font-size: 18px; margin-bottom: 15px; margin-top: 40px;">
                            Salom, $user.firstName!
                          </div>

                          <!-- Instructions -->
                          <div style="color: #2c3a45; margin: 0 auto 25px; width: 80%; text-align: center;">
                            Siz hali hisobingizni faollashtirmadingiz. Ro'yxatdan o'tishni
                            yakunlash va ishni boshlash uchun quyidagi tugmani bosing.
                          </div>

                          <!-- Activate Button -->
                          <div style="text-align: center; margin-bottom: 30px;">
                            <a href="$HOST/auth/account?uid=$uid&cid=$companyid&sid=$serviceid"
                              style="color: #007de8; display: block; margin: 0 auto; text-decoration: none;">
                              <table border="0" cellpadding="0" cellspacing="0"
                                style="background-color: #2bbe57; border-radius: 5px; margin: auto;">
                                <tbody>
                                  <tr>
                                    <td align="center" valign="middle" width="160"
                                      style="color: #FFFFFF; font-size: 13px; font-weight: bold;
                                             line-height: 55px; text-align: center;">
                                      <a href="$HOST/auth/account?uid=$uid&cid=$companyid&sid=$serviceid"
                                        target="_blank"
                                        style="color: #FFFFFF; display: block; font-family: sans-serif !important;
                                               font-size: 13px; font-weight: bold; text-align: center;
                                               text-decoration: none;">
                                        Hisobni Faollashtirish
                                      </a>
                                    </td>
                                  </tr>
                                </tbody>
                              </table>
                            </a>
                          </div>

                          <!-- Fallback link -->
                          <div style="color: #8a9baa; font-size: 12px; margin-bottom: 10px; padding: 0 10px;">
                            Tugma ishlamasa, quyidagi havolani brauzeringizga ko'chirib joylashtiring:
                          </div>
                          <div style="color: #007de8; font-size: 11px; padding: 0 10px; word-break: break-all;">
                            <a href="$HOST/auth/account?uid=$uid&cid=$companyid&sid=$serviceid"
                              style="color: #007de8; text-decoration: none;">
                              $HOST/auth/account?uid=$uid&amp;cid=$companyid&amp;sid=$serviceid
                            </a>
                          </div>

                        </td>
                      </tr>

                      <!-- Card Bottom Row -->
                      <tr style="vertical-align: top;">

                        <!-- Left: Account info -->
                        <td width="140"
                          style="background-color: #2D3945; border-radius: 0 0 10px 10px; color: white;
                                 padding: 15px 25px 20px; vertical-align: top;">
                          <div style="font-size: 13px; line-height: 1.85;">
                            <div>Hisob:</div>
                            <div style="color: #b0bec8; max-width: 140px; overflow-wrap: break-word; word-wrap: break-word;">
                              $user.firstName
                            </div>
                          </div>
                        </td>

                        <!-- Right: Empty white area -->
                        <td
                          style="background-color: white; border-radius: 0 0 10px 10px;
                                 padding: 15px 25px 20px; vertical-align: top;">
                        </td>

                      </tr>

                    </tbody>
                  </table>


                  <!-- ============================================================
                       SECTION 3 — SUPPORT / QUESTIONS
                  ============================================================ -->
                  <table cellpadding="0" border="0" width="100%"
                    style="border-collapse: separate; border-spacing: 17px 0; margin-bottom: 17px; padding: 0;">
                    <tbody>
                      <tr>
                        <td
                          style="background-color: white; border-radius: 10px;
                                 padding: 30px 25px; vertical-align: top;">

                          <table cellpadding="0" cellspacing="0" border="0" style="font-size: 16px; width: 100%;">
                            <tbody>
                              <tr style="vertical-align: top;">

                                <!-- Text -->
                                <td valign="top" style="vertical-align: top;">
                                  <div style="color: #2c3a45; font-size: 16px; line-height: 1.5;">
                                    <div style="font-size: 18px; margin-bottom: 15px;">Savollar bormi?</div>
                                    <div>
                                      Bizga elektron pochta yuboring:&nbsp;<br>
                                      <a href="mailto:info@brain.uz"
                                        style="color: #007de8; text-decoration: none;">
                                        info@brain.uz
                                      </a>,
                                      &nbsp;<a href="#" style="color: #2c3a45; text-decoration: none;">jonli chat</a>
                                      orqali yozing yoki&nbsp;
                                      <a href="#" style="color: #2c3a45; text-decoration: none;">qayta qo'ng'iroq</a>
                                      buyurtma qiling.
                                    </div>
                                  </div>
                                </td>

                                <!-- Illustration -->
                                <td valign="top" width="250" align="right" style="vertical-align: top;">
                                  <img
                                    src="$host/mainStyles/new-ui/images/emailTemplateService/brainAuto.png"
                                    width="178" height="162" alt="" border="0"
                                    style="-ms-interpolation-mode: bicubic; display: block;
                                           margin-left: auto; margin-right: 10px; max-width: 100%;">
                                </td>

                              </tr>
                            </tbody>
                          </table>

                        </td>
                      </tr>
                    </tbody>
                  </table>


                  <!-- ============================================================
                       SECTION 4 — FOOTER
                  ============================================================ -->
                  <table cellpadding="0" border="0" width="100%"
                    style="border-collapse: separate; border-spacing: 17px 0; padding: 0;">
                    <tbody>
                      <tr>
                        <td style="font-size: 12px; opacity: 0.7; padding: 10px 25px 30px; text-align: center; vertical-align: top;">
                          &copy; $currentYear Brain IT &amp; Business, Toshkent, Uzbekistan
                        </td>
                      </tr>
                    </tbody>
                  </table>


                </td>
              </tr>
            </tbody>
          </table>
          <!-- /INNER CONTAINER -->

        </td>
      </tr>
    </tbody>
  </table>
  <!-- /OUTER WRAPPER -->

</body>
</html>