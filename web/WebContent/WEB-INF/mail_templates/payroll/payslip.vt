## $employeeName - Employee Name
## $companyName - Company Name
## $startDate - Period start date
## $endDate - Period end date
## $weekMonthNo - Week Month Number

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8" /></head>
<body>
<p>Dear $employeeName,</p>
Attached please find printer-friendly version of your payslip (in PDF format) with all payment and deduction details issued by $companyName for a period of
$startDate - $endDate ( $weekMonthNo ).
<p>Please feel free to contact your HR department should you have any questions.</p>
</body></html>


