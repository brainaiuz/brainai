<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
<title>Request For Quote</title>
</head>
<body>

<p>
Dear $CONTACT_NAME,
$COMPANY_NAME has sent you a request for quote.
</p>

#if($INTRODUCTION!='')
<p><strong>$INTRODUCTION</strong></p>
#end

#if($ACTIVATION_LINK!='')
<p>To view the quote, please activate your account for free by clicking the link <a href="$ACTIVATION_LINK">$ACTIVATION_LINK</a></p>
#end

</body>
</html>