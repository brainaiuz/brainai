<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">

<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width">
    <title>Free trial is expiring</title>

</head>

<body style="-moz-box-sizing: border-box; -ms-text-size-adjust: 100%; -webkit-box-sizing: border-box; -webkit-text-size-adjust: 100%; Margin: 0; box-sizing: border-box; color: #2c3a45; font-family: Montserrat, Helvetica Neue, Helvetica, Arial, sans-serif !important; font-size: 16px; font-weight: normal; line-height: 1.5; margin: 0; min-width: 100%; padding: 0; text-align: left; width: 100% !important;">
<style>@import url('https://fonts.googleapis.com/css?family=Montserrat');

body,
table.body,
h1,
h2,
h3,
h4,
h5,
h6,
p,
td,
th {
    color: #2c3a45;
    font-family: Montserrat, Helvetica Neue, Helvetica, Arial, sans-serif;
    font-weight: normal;
    padding: 0;
    margin: 0;
    Margin: 0;
    text-align: left;
    line-height: 1.5;
}
</style>
<table class="body" cellpadding="0" cellspacing="0" border="0"
       style="Margin: 0; background: #eceff3; color: #2c3a45; font-family: Montserrat , Helvetica, Arial, sans-serif; font-size: 16px; font-weight: normal; height: 100%; line-height: 1.5; margin: 0; padding: 0; text-align: left; vertical-align: top; width: 100%;">
    <tbody>
    <tr style="padding: 0; text-align: left; vertical-align: top;">
        <td style="Margin: 0; color: #2c3a45; font-family: Montserrat , Helvetica, Arial, sans-serif; font-size: 16px; font-weight: normal; line-height: 1.5; margin: 0; padding: 0; text-align: left; vertical-align: top;">
            <table class="container" cellpadding="0" cellspacing="0" border="0"
                   style="Margin: 0 auto; margin: 0 auto; padding: 0; text-align: inherit; vertical-align: top; width: 634px;">
                <tbody>
                <tr style="padding: 0; text-align: left; vertical-align: top;">
                    <td style="Margin: 0; color: #2c3a45; font-family: Montserrat , Helvetica, Arial, sans-serif; font-size: 16px; font-weight: normal; line-height: 1.5; margin: 0; padding: 0; text-align: left; vertical-align: top;">

                        <table class="row" cellspacing="0" cellpadding="0" border="0"
                               style="border-collapse: separate; border-spacing: 17px 0; padding: 0; text-align: left; vertical-align: top; width: 100%;">
                            <tbody>
                            <tr style="padding: 0; text-align: left; vertical-align: top;">
                                <td valign="middle"
                                    style="Margin: 0; color: #2c3a45; font-family: Montserrat , Helvetica, Arial, sans-serif; font-size: 16px; font-weight: normal; line-height: 1.5; margin: 0; padding: 0; padding-bottom: 30px; padding-top: 30px; text-align: left; vertical-align: middle; width: 70px;">
                                    <img src="$logo"
                                         width="56" height="54" alt="" border="0"
                                         style="-ms-interpolation-mode: bicubic; clear: both; display: block; max-width: 100%; outline: none; text-decoration: none; width: auto;">
                                </td>
                                <td valign="middle"
                                    style="Margin: 0; color: #2c3a45; font-family: Montserrat, Helvetica Neue, Helvetica, Arial, sans-serif; font-size: 16px; font-weight: normal; line-height: 1.5; margin: 0; padding: 0; padding-bottom: 30px; padding-top: 36px; text-align: left; vertical-align: top;">
                                    <div style="font-size: 13px;">
                                        All-in-one business <br>management software
                                    </div>
                                </td>
                            </tr>
                            </tbody>
                        </table>

                        <table class="row" cellpadding="0" border="0" width="100%"
                               style="border-collapse: separate; border-spacing: 17px 0; margin-bottom: 17px; padding: 0; text-align: left; vertical-align: top; width: 100%;">
                            <tbody>
                            <tr style="padding: 0; text-align: left; vertical-align: top;">
                                <td valign="top"
                                    style="Margin: 0; background-color: #2D3945; border-radius: 10px 10px 0 0; color: white; font-family: Montserrat , Helvetica, Arial, sans-serif; font-size: 16px; font-weight: normal; line-height: 1.5; margin: 0; padding: 30px 25px 0; text-align: left; vertical-align: top; width: 140px;">
                                    <img
                                         style="-ms-interpolation-mode: bicubic; clear: both; display: block; margin-bottom: 20px; max-width: 100%; outline: none; text-decoration: none;"
                                         src="$host/mainStyles/new-ui/images/emailTemplateService/user-plus.png"
                                         alt="" border="0">
                                    <div style=" line-height: 1.375; ">
                                        You`ve Been Invited to Try kpi.com by <b style="color: #2bbe57; text-decoration:none;">$senderName</b>
                                    </div>
                                </td>
                                <td valign="top"
                                    style="Margin: 0; background-color: white; border-radius: 10px 10px 0 0; color: #2c3a45; font-family: Montserrat , Helvetica, Arial, sans-serif; font-size: 16px; font-weight: normal; line-height: 1.5; margin: 0; padding: 30px 25px 0; text-align: center; vertical-align: top;">

                                    <div style="font-size: 18px; margin-bottom: 15px; margin-top: 60px;">Hello, there!
                                    </div>
                                    <div style="margin-bottom: 25px;color: #2c3a45;">
									<div style="font-weight: normal; margin-bottom: 0;font-size: 16px;margin-bottom: 10px">Facebook post from $senderName</div>
										<i>"$content"</i>
                                </td>
                            </tr>
                            <tr style="padding: 0; text-align: left; vertical-align: top;">
                                <td style="Margin: 0; background-color: #2D3945; border-radius: 0 0 10px 10px; color: white; font-family: Montserrat , Helvetica, Arial, sans-serif; font-size: 16px; font-weight: normal; line-height: 1.5; margin: 0; padding: 15px 25px 20px; text-align: left; vertical-align: top; width: 140px;">
                                    <div style="font-size: 13px; line-height: 1.85;">
                                        <div style="">Email:</div>
                                        <div style="color: #b0bec8;overflow-wrap: break-word;word-wrap: break-word;max-width: 140px;"><a
                                                href="#" style="color: #b0bec8;overflow-wrap: break-word;word-wrap: break-word;max-width: 140px; text-decoration: none;">$senderEmail</a></div>
                                    </div>
                                    </div>
                                    <div style="font-size: 13px; line-height: 1.85;">
                                        <div style="">Company Name:</div>
                                        <div style="color: #b0bec8;overflow-wrap: break-word;word-wrap: break-word;max-width: 140px;"><a
                                                href="#" style="color: #b0bec8;overflow-wrap: break-word;word-wrap: break-word;max-width: 140px; text-decoration: none;">$companyName</a></div>
                                    </div>
                                    </div>
                                </td>
                                <td style="Margin: 0; background-color: white; border-radius: 0 0 10px 10px; color: #2c3a45; font-family: Montserrat , Helvetica, Arial, sans-serif; font-size: 16px; font-weight: normal; line-height: 1.5; margin: 0; padding: 15px 25px 20px; text-align: left; vertical-align: top;">
                                    <div style="text-align: center;">
                                        What`s to lose?
                                    </div>
                                </td>
                            </tr>
                            </tbody>
                        </table

                        <table class="row" cellpadding="0" border="0" width="100%"
                               style="border-collapse: separate; border-spacing: 17px 0; padding: 0; text-align: left; vertical-align: top; width: 100%;">
                            <tbody>
                            <tr style="padding: 0; text-align: left; vertical-align: top;">
                                <td style="Margin: 0; color: #2c3a45; font-family: Montserrat , Helvetica, Arial, sans-serif; font-size: 12px; font-weight: normal; line-height: 1.5; margin: 0; padding: 0; padding-bottom: 30px; padding-left: 25px; padding-right: 25px; padding-top: 10px; text-align: center; vertical-align: top;">
                                    <div style="opacity: 0.7;">© $currentYear  KPI Software Limited, 80 Alleyn Park, Dulwich, London,
                                         SE21 8SL, UK
                                    </div>
                                </td>
                            </tr>
                            </tbody>
                        </table>

                    </td>
                </tr>
                </tbody>
            </table>
        </td>
    </tr>
    </tbody>
</table>


</body>

</html>