<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE taglib PUBLIC "-//Sun Microsystems, Inc.//DTD JSP Tag Library 1.1//EN"
        "http://java.sun.com/j2ee/dtds/web-jsptaglibrary_1_1.dtd">
<taglib>
    <tlibversion>1.0</tlibversion>
    <jspversion>2.0</jspversion>
    <shortname>Jsp Wfp Custom tags</shortname>
    <tag>
        <name>PagaManagerTag</name>
        <tagclass>com.finnetlimited.wfpcms.tags.maintags.PageManagerTag</tagclass>
        <bodycontent>empty</bodycontent>
        <attribute>
            <name>pageSettings</name>
            <rtexprvalue>true</rtexprvalue>
        </attribute>
    </tag>

    <tag>
        <name>WfpPosition</name>
        <tagclass>com.finnetlimited.wfpcms.tags.maintags.WfpPositionTag</tagclass>
        <bodycontent>empty</bodycontent>
    </tag>

</taglib>