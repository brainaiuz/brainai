    <bean id="wfmServiceExporter"
          class="com.edatasite.workforce.gwt.core.server.servlets.WfmServiceExporterFactoryBean">
        <constructor-arg index="0" ref="xssFilter"/>
    </bean>

    <bean id="xssFilter"
          class="com.edatasite.workforce.gwt.core.server.security.XSSFilter">
        <property name="exclusions">
            <list value-type="java.lang.String">
                <value>|saveCompanyPdfTemplate|</value>
                <value>|saveCertificate|</value>
                <value>|sendTestEmail|</value>
                <value>|saveMailMessage|</value>
                <value>|saveSignature|</value>
                <value>|sendMessage|</value>
                <value>|sendEmailToCaseReporter|</value>
                <value>|createUpdateEmailTemplate|</value>
                <value>|saveWorkflowAlert|</value>
            </list>
        </property>
    </bean>

