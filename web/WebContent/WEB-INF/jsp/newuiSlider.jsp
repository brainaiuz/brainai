<%@ taglib uri="http://java.sun.com/jsp/jstl/fmt" prefix="fmt" %>
<div class="cp_slider">
    <div class="cp_slider__bg-imgs">
        <div class="cp_slider__bg-img"
             style="background-image:url(/mainStyles/new-ui/login/img/bg/sectionbg1.jpg);"></div>
        <div class="cp_slider__bg-img"
             style="background-image:url(/mainStyles/new-ui/login/img/bg/sectionbg2.jpg);"></div>
        <div class="cp_slider__bg-img"
             style="background-image:url(/mainStyles/new-ui/login/img/bg/sectionbg3.jpg);"></div>
        <div class="cp_slider__bg-img"
             style="background-image:url(/mainStyles/new-ui/login/img/bg/sectionbg4.jpg);"></div>
        <div class="cp_slider__bg-img"
             style="background-image:url(/mainStyles/new-ui/login/img/bg/sectionbg5.jpg);"></div>
        <div class="cp_slider__bg-img"
             style="background-image:url(/mainStyles/new-ui/login/img/bg/sectionbg6.jpg);"></div>
    </div>
    <div class="cp_slider__frame cp_slider__frame--top">
        <svg width="454" height="198" viewBox="0 0 454 198" version="1.1" xmlns="http://www.w3.org/2000/svg"
             xmlns:xlink="http://www.w3.org/1999/xlink">
            <g id="Canvas" transform="translate(-586 -84)">
                <g id="Vector">
                    <use xlink:href="#path_slide-frame" transform="translate(586.5 84.5)" fill="#ffffff"/>
                </g>
            </g>
            <defs>
                <path id="path_slide-frame"
                      d="M 369.5 88L 0 0L 453.5 0L 453.5 197.5C 453.5 100.5 369.5 88 369.5 88Z"/>
            </defs>
        </svg>
    </div>
    <div class="cp_slider__frame cp_slider__frame--bottom">
        <svg width="454" height="198" viewBox="0 0 454 198" version="1.1" xmlns="http://www.w3.org/2000/svg"
             xmlns:xlink="http://www.w3.org/1999/xlink">
            <g id="Canvas" transform="translate(-586 -84)">
                <g id="Vector">
                    <use xlink:href="#path_slide-frame" transform="translate(586.5 84.5)" fill="#ffffff"/>
                </g>
            </g>
            <defs>
                <path id="path_slide-frame"
                      d="M 369.5 88L 0 0L 453.5 0L 453.5 197.5C 453.5 100.5 369.5 88 369.5 88Z"/>
            </defs>
        </svg>
    </div>
    <div class="cp_slider__items-container">
        <div class="cp_slider__items-innerbox">
            <div class="cp_slider__items">
                <div class="cp_slider__item">
                    <div class="cp_slider__logo"><img src="/mainStyles/new-ui/login/img/logo/accounts.svg"></div>
                    <div class="cp_slider__title"><span><fmt:message key="main.accountingFinance"/></span></div>
                    <div class="cp_slider__text"><span><fmt:message key="main.accountsDesc"/></span></div>
                </div>
                <div class="cp_slider__item">
                    <div class="cp_slider__logo"><img src="/mainStyles/new-ui/login/img/logo/sales.svg"></div>
                    <div class="cp_slider__title"><span><fmt:message key="main.CRM"/></span></div>
                    <div class="cp_slider__text"><span><fmt:message key="main.CRMDesc"/></span></div>
                </div>
                <div class="cp_slider__item">
                    <div class="cp_slider__logo"><img src="/mainStyles/new-ui/login/img/logo/hr.svg"></div>
                    <div class="cp_slider__title"><span><fmt:message key="main.HRMS"/></span></div>
                    <div class="cp_slider__text"><span><fmt:message key="main.HRMSDesc"/></span></div>
                </div>
                <div class="cp_slider__item">
                    <div class="cp_slider__logo"><img src="/mainStyles/new-ui/login/img/logo/reporting.svg"></div>
                    <div class="cp_slider__title"><span><fmt:message key="main.reporting"/></span></div>
                    <div class="cp_slider__text"><span><fmt:message key="main.reportingDesc"/></span></div>
                </div>
                <div class="cp_slider__item">
                    <div class="cp_slider__logo"><img src="/mainStyles/new-ui/login/img/logo/projects.svg"></div>
                    <div class="cp_slider__title"><span><fmt:message key="main.projectManagment"/></span></div>
                    <div class="cp_slider__text"><span><fmt:message key="main.projectManagmentDesc"/></span></div>
                </div>
                <div class="cp_slider__item">
                    <div class="cp_slider__logo"><img src="/mainStyles/new-ui/login/img/logo/documents.svg"></div>
                    <div class="cp_slider__title"><span><fmt:message key="main.documents"/></span></div>
                    <div class="cp_slider__text"><span><fmt:message key="main.documentsDesc"/></span></div>
                </div>
            </div>
        </div>
    </div>
</div>
