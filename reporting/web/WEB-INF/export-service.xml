<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
                           http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd">

    <context:annotation-config/>
    <context:component-scan base-package="com.edatasite.workforce.core.config.datasource"/>

    <bean name="csvReportHandler" scope="prototype"
          class="com.finnetlimited.reportservice.core.server.handler.CsvReportHandler"/>

    <bean name="pdfReportHandler" scope="prototype"
          class="com.finnetlimited.reportservice.core.server.handler.PdfReportHandler"/>

    <bean name="pdfRuntimeReportHandler" scope="prototype"
          class="com.finnetlimited.reportservice.core.server.handler.PdfRuntimeReportHandler"/>

    <bean name="excelImportHandler" scope="prototype"
          class="com.finnetlimited.reportservice.core.server.handler.ExcelImportHandler">
        <property name="dataSourceXLS" ref="reportingDataSource"/>
    </bean>
</beans>
